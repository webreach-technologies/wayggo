---
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import { bucketPageHref, getPaginationRange, type Bucket } from "../../lib/tourBus";
import { withBase } from "../../lib/url";

interface Props {
  bucket: Bucket;
  currentPage: number;
  totalPages: number;
}

const { bucket, currentPage, totalPages } = Astro.props;
---

{totalPages > 1 && (
  <div class="flex justify-center items-center gap-2 mt-12">
    {currentPage > 1 ? (
      <a
        href={withBase(bucketPageHref(bucket, currentPage - 1))}
        class="pagination-arrow w-10 h-10 rounded-full flex items-center justify-center transition-all shrink-0"
        style="border: 2px solid #E5E7EB; color: #1A2744;"
        aria-label="Previous page"
      >
        <ChevronLeft size={18} />
      </a>
    ) : (
      <span
        class="pagination-arrow w-10 h-10 rounded-full flex items-center justify-center shrink-0"
        style="border: 2px solid #E5E7EB; color: #1A2744; opacity: 0.4;"
        aria-hidden="true"
      >
        <ChevronLeft size={18} />
      </span>
    )}

    <div class="flex items-center flex-wrap justify-center gap-2">
      {getPaginationRange(currentPage, totalPages).map((token) =>
        token === "ellipsis" ? (
          <span
            class="w-10 h-10 flex items-center justify-center text-sm font-bold shrink-0"
            style="color: #1A2744; opacity: 0.4;"
            aria-hidden="true"
          >
            …
          </span>
        ) : (
          <a
            href={withBase(bucketPageHref(bucket, token))}
            class="pagination-page w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold transition-all shrink-0"
            style={`background-color: ${token === currentPage ? "#1A2744" : "transparent"}; color: ${token === currentPage ? "white" : "#1A2744"}; border: 2px solid ${token === currentPage ? "#1A2744" : "#E5E7EB"};`}
            aria-current={token === currentPage ? "page" : undefined}
          >
            {token}
          </a>
        )
      )}
    </div>

    {currentPage < totalPages ? (
      <a
        href={withBase(bucketPageHref(bucket, currentPage + 1))}
        class="pagination-arrow w-10 h-10 rounded-full flex items-center justify-center transition-all shrink-0"
        style="border: 2px solid #E5E7EB; color: #1A2744;"
        aria-label="Next page"
      >
        <ChevronRight size={18} />
      </a>
    ) : (
      <span
        class="pagination-arrow w-10 h-10 rounded-full flex items-center justify-center shrink-0"
        style="border: 2px solid #E5E7EB; color: #1A2744; opacity: 0.4;"
        aria-hidden="true"
      >
        <ChevronRight size={18} />
      </span>
    )}
  </div>
)}
