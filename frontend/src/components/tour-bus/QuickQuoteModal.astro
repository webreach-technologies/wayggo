---
// Lightweight quick-request modal, opened from any element on the page that
// carries `data-qqm-open` (currently just the hero CTA). Kept as a native
// <dialog> instead of a React island since the form has no branching state —
// just four fields and a fake client-side "submitted" swap, same pattern as
// TourBusBookingForm's success screen but without the multi-step wizard.
import { X, Send, Check } from "@lucide/astro";

interface Props {
  tourBusLabel: string;
}

const { tourBusLabel } = Astro.props;
---

<dialog id="quick-quote-modal" class="qqm-dialog" aria-labelledby="qqm-title">
  <div class="qqm-panel">
    <button type="button" class="qqm-close" data-qqm-close aria-label="Close">
      <X size={20} stroke-width={2} />
    </button>

    <div class="qqm-body" data-qqm-form-view>
      <span class="section-label mb-3 inline-flex">Quick Request</span>
      <h3 id="qqm-title" class="qqm-title">Request the {tourBusLabel} Tour Bus</h3>
      <p class="qqm-sub">Share your details and our operations team will follow up with a proposal within 24 hours.</p>

      <form class="qqm-form" data-qqm-form novalidate>
        <div class="qqm-field">
          <label for="qqm-name">Full Name *</label>
          <input id="qqm-name" name="name" type="text" required placeholder="Jane Smith" />
        </div>
        <div class="qqm-field">
          <label for="qqm-email">Email Address *</label>
          <input id="qqm-email" name="email" type="email" required placeholder="you@example.com" />
        </div>
        <div class="qqm-field">
          <label for="qqm-phone">Phone Number *</label>
          <input id="qqm-phone" name="phone" type="tel" required placeholder="+1 416 555 0123" />
        </div>
        <div class="qqm-field">
          <label for="qqm-info">Additional Info / Itinerary</label>
          <textarea id="qqm-info" name="info" rows="3" placeholder="Travel dates, group size, stops you'd like to hit..."></textarea>
        </div>
        <button type="submit" class="btn-primary qqm-submit">
          Submit Request
          <Send size={16} stroke-width={2} />
        </button>
      </form>
    </div>

    <div class="qqm-body qqm-success" data-qqm-success-view hidden>
      <div class="qqm-success-icon">
        <Check size={28} color="#1A2744" stroke-width={3} />
      </div>
      <h3 class="qqm-title">Request Received!</h3>
      <p class="qqm-sub" data-qqm-success-msg>
        Thanks — we've received your request and will follow up within 24 hours.
      </p>
      <button type="button" class="btn-secondary qqm-submit" data-qqm-close>Done</button>
    </div>
  </div>
</dialog>

<style>
  .qqm-dialog {
    padding: 0;
    border: none;
    border-radius: 24px;
    width: min(92vw, 480px);
    max-height: 90vh;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(13, 17, 38, 0.35);
    /* Tailwind's preflight zeroes margin on every element, which clobbers the
       UA stylesheet's `margin: auto` that centers dialog:modal — restore it
       explicitly or the dialog pins to the top-left of the viewport. */
    margin: auto;
  }

  .qqm-dialog::backdrop {
    background: rgba(13, 17, 38, 0.6);
    backdrop-filter: blur(2px);
  }

  .qqm-panel {
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
  }

  .qqm-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: #F9F7F2;
    color: #1A2744;
    cursor: pointer;
    transition: background-color 0.15s;
    z-index: 1;
  }

  .qqm-close:hover {
    background: #F0ECE1;
  }

  .qqm-body {
    padding: 2rem 1.75rem 1.75rem;
  }

  .qqm-title {
    color: #1A2744;
    font-size: 1.375rem;
    font-weight: 900;
    margin-bottom: 0.5rem;
    padding-right: 2rem;
  }

  .qqm-sub {
    color: #6B7280;
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .qqm-form {
    display: grid;
    gap: 1rem;
  }

  .qqm-field label {
    display: block;
    font-weight: 600;
    font-size: 0.8125rem;
    color: #1A2744;
    margin-bottom: 0.35rem;
    letter-spacing: 0.02em;
  }

  .qqm-field input,
  .qqm-field textarea {
    display: block;
    width: 100%;
    padding: 0.8rem 1rem;
    border: 2px solid #E5E7EB;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-family: inherit;
    color: #0D0D0D;
    background: white;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
    resize: vertical;
  }

  .qqm-field input:focus,
  .qqm-field textarea:focus {
    border-color: #1A2744;
    box-shadow: 0 0 0 3px rgba(26, 39, 68, 0.08);
  }

  .qqm-field input:invalid.qqm-touched,
  .qqm-field textarea:invalid.qqm-touched {
    border-color: #EF4444;
  }

  .qqm-submit {
    width: 100%;
    margin-top: 0.25rem;
  }

  .qqm-success {
    text-align: center;
  }

  .qqm-success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(253, 234, 1, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .qqm-success .qqm-title,
  .qqm-success .qqm-sub {
    padding-right: 0;
  }

  @media (max-width: 480px) {
    .qqm-dialog {
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
    }

    .qqm-panel {
      max-height: 100dvh;
      height: 100%;
    }

    .qqm-body {
      padding: 4rem 1.25rem 2rem;
    }
  }
</style>

<script>
  function initQuickQuoteModal() {
    const dialog = document.getElementById("quick-quote-modal") as HTMLDialogElement | null;
    if (!dialog) return;

    const formView = dialog.querySelector("[data-qqm-form-view]") as HTMLElement;
    const successView = dialog.querySelector("[data-qqm-success-view]") as HTMLElement;
    const successMsg = dialog.querySelector("[data-qqm-success-msg]") as HTMLElement;
    const form = dialog.querySelector("[data-qqm-form]") as HTMLFormElement;

    const resetToForm = () => {
      formView.hidden = false;
      successView.hidden = true;
      form.reset();
      form.querySelectorAll(".qqm-touched").forEach((el) => el.classList.remove("qqm-touched"));
    };

    document.querySelectorAll("[data-qqm-open]").forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        resetToForm();
        dialog.showModal();
      });
    });

    dialog.querySelectorAll("[data-qqm-close]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });

    // Clicking the backdrop area (the dialog element itself, outside the panel) closes it.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const inputs = Array.from(form.querySelectorAll("input, textarea")) as (HTMLInputElement | HTMLTextAreaElement)[];
      inputs.forEach((el) => el.classList.add("qqm-touched"));
      if (!form.checkValidity()) return;

      const name = (form.querySelector("#qqm-name") as HTMLInputElement).value.trim();
      successMsg.textContent = `Thanks, ${name} — we've received your request and will follow up within 24 hours.`;
      formView.hidden = true;
      successView.hidden = false;
    });
  }

  initQuickQuoteModal();
  document.addEventListener("astro:page-load", initQuickQuoteModal);
</script>
