---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../sections/PageHero.astro";
import TourBusFilterBar from "./TourBusFilterBar.astro";
import TourBusGrid from "./TourBusGrid.astro";
import TourBusPagination from "./TourBusPagination.astro";
import { Plus } from "@lucide/astro";
import {
  PAGE_SIZE,
  bucketPageHref,
  bucketSeo,
  bucketBreadcrumbs,
  type Bucket,
  type TourBusCard,
} from "../../lib/tourBus";

interface Props {
  bucket: Bucket;
  page: number;
  totalPages: number;
  pageCards: TourBusCard[];
  totalInBucket: number;
}

const { bucket, page, totalPages, pageCards, totalInBucket } = Astro.props;

const seo = bucketSeo(bucket, page, totalInBucket);
const breadcrumbs = bucketBreadcrumbs(bucket);
// Country/state filter pages (bucket.country set) are real, useful nav
// targets but not meant to be a separate indexable surface — only the main
// /tour-bus listing (and its numbered pages) and individual entry pages
// are indexable. `follow` still lets crawlers reach the linked entry pages.
const noindex = !!bucket.country;

const siteOrigin = Astro.site ?? new URL("https://wayggo.com");
const tourBusItemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: pageCards.map((pkg, i) => ({
    "@type": "ListItem",
    position: (page - 1) * PAGE_SIZE + i + 1,
    url: new URL(pkg.detailHref, siteOrigin).href,
    name: pkg.name,
  })),
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  breadcrumbs={breadcrumbs}
  noindex={noindex}
  prevHref={page > 1 ? bucketPageHref(bucket, page - 1) : undefined}
  nextHref={page < totalPages ? bucketPageHref(bucket, page + 1) : undefined}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(tourBusItemListSchema)} />

  <!-- Hero -->
  <PageHero
    badge={seo.badge}
    heading={'Group Tour Bus<br /><span style="color: #FDEA01;">Across North America</span>'}
    subheading="Curated ground transportation tour bus itineraries for international tour operators. All vehicles, all drivers, all transfers — included. Request any tour bus or mix and match cities for a custom itinerary."
  />

  <!-- Filter bar -->
  <TourBusFilterBar bucket={bucket} />

  <!-- Tour bus listings -->
  <section class="py-16 lg:py-20" style="background-color: white;">
    <div class="container">
      <TourBusGrid cards={pageCards} />
      <TourBusPagination bucket={bucket} currentPage={page} totalPages={totalPages} />
    </div>
  </section>

  <!-- Custom CTA -->
  <section class="py-20 diagonal-lines" style="background-color: #1A2744;">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-6" style="background-color: #FDEA01;">
          <Plus size={28} color="#1A2744" stroke-width={2.5} />
        </div>
        <h2 class="text-3xl font-black text-white mb-4">
          Have a Custom Route?<br />
          <span style="color: #FDEA01;">We'll Build It.</span>
        </h2>
        <p class="text-white/60 mb-8 leading-relaxed">
          Don't see exactly what your client needs? Tell us the cities, the dates, and the group size — our operations team will design a bespoke transportation itinerary within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn-primary">Request Custom Itinerary</a>
          <a href="/network" class="btn-outline-white">View Our Coverage</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
