---
import { Shield, Star, Users, type AstroComponent } from "@lucide/astro";
import { withBase } from "../../lib/url";

interface Pillar {
  icon: AstroComponent;
  num: string;
  title: string;
  tagline?: string;
  desc: string;
}

interface Props {
  heading?: string;
  subheading?: string;
  pillars?: Pillar[];
}

const {
  heading = "More Than a \n Booking Platform",
  subheading = "WAYGGO is designed to be a dedicated ground transportation partner for North American group travel.\nInstead of requiring travel professionals to manage transportation relationships market by market, WAYGGO brings the coordination together through one relationship.",
  pillars = [
    {
      icon: Shield,
      num: "01",
      title: "One Point of Contact",
      desc: "A single transportation relationship can simplify communication across multiple cities, operators, and itinerary legs. Instead of managing several transportation providers independently, you have one place to coordinate the ground operation.",
    },
    {
      icon: Star,
      num: "02",
      title: "Flexibility Around the Itinerary",
      desc: "Different groups require different transportation solutions. From smaller vans to full-size motor coaches, and from single-city movements to multi-destination itineraries, transportation can be organized around the requirements of the journey.",
    },
    {
      icon: Users,
      num: "03",
      title: "A Vetted Transportation Network",
      desc: "WAYGGO's network is built around transportation operators that go through an established vetting process covering areas such as licensing, insurance, vehicle inspection, driver background checks, and client references.",
    },
  ],
} = Astro.props;

const headingLines = heading.split("\n");
const subheadingParagraphs = subheading.split("\n");

// "Learn More About WAYGGO" button hidden for now; set true to show it again
const SHOW_CTA = false;
---

<section class="py-14" style="background: white;">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left heading column -->
      <div class="lg:col-span-4">
        <span class="section-label">Why WAYGGO</span>
        <h2 class="text-4xl lg:text-4xl font-black mt-5 mb-6 leading-tight"
          style="color: #1A2744;">
          {headingLines.map((line, i) => (
            <>
              {line}
              {i < headingLines.length - 1 && <br />}
            </>
          ))}
        </h2>
        <div class="space-y-4 mb-8">
          {subheadingParagraphs.map((p) => (
            <p class="font-subheading text-base leading-relaxed" style="color: #6B7280;">
              {p}
            </p>
          ))}
        </div>
        {SHOW_CTA && (
          <a href={withBase("/about")} class="btn-secondary">Learn More About WAYGGO</a>
        )}
      </div>

      <!-- Right: 3 pillar cards -->
      <div class="lg:col-span-8 flex flex-col gap-4">
        {pillars.map((pillar) => {
          const PillarIcon = pillar.icon;
          return (
          <div class="flex items-start gap-6 bg-white rounded-2xl p-7"
            style="box-shadow: 0 2px 16px rgba(26,39,68,0.06);">
            <div class="w-14 h-14 rounded-2xl shrink-0 flex items-center justify-center"
              style="background: #1A2744;">
              <PillarIcon size={22} color="#FDEA01" stroke-width={2.5} />
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-1">
                <span class="font-heading text-xs font-black uppercase tracking-widest" style="color: #FDEA01;">{pillar.num}</span>
                <h3 class="text-lg font-black" style="color: #1A2744;">{pillar.title}</h3>
              </div>
              {pillar.tagline && (
                <p class="text-sm font-semibold italic mb-2" style="color: rgba(26,39,68,0.5);">"{pillar.tagline}"</p>
              )}
              <p class="text-sm leading-relaxed" style="color: #6B7280;">{pillar.desc}</p>
            </div>
          </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
