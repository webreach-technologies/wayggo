---
// Centered badge + heading + optional subheading used at the top of content sections.
interface Props {
  badge?: string;
  heading: string;
  subheading?: string;
  /** White text for navy backgrounds. */
  dark?: boolean;
}

const { badge, heading, subheading, dark = false } = Astro.props;

// Separate paragraphs with "\n"; multi-paragraph copy gets a wider measure.
const paragraphs = subheading ? subheading.split("\n") : [];
const widthClass = paragraphs.length > 1 ? "max-w-3xl" : "max-w-xl";
---

<div class="text-center mb-12">
  {badge && <span class={dark ? "section-label-white" : "section-label"}>{badge}</span>}
  <h2
    class:list={["text-3xl lg:text-4xl font-black", { "mt-4": badge }, { "text-white": dark }]}
    style={dark ? undefined : "color: #1A2744;"}
  >
    {heading}
  </h2>
  {paragraphs.map((p) => (
    <p class:list={["font-subheading mt-3 mx-auto", widthClass, dark ? "text-white/60" : "text-gray-500"]}>
      {p}
    </p>
  ))}
</div>
