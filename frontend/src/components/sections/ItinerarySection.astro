---
import SectionHeading from "./SectionHeading.astro";
import { withBase } from "../../lib/url";

interface Day {
  day: string;
  title: string;
  stops: string[];
  vehicle: string;
}

interface Props {
  badge?: string;
  heading: string;
  subheading?: string;
  days: Day[];
  cta?: { label: string; href: string };
}

const { badge = "Sample Itinerary", heading, subheading, days, cta } = Astro.props;
---

<section class="py-20" style="background-color: #F9F7F2;">
  <div class="container">
    <div class="max-w-3xl mx-auto">
      <SectionHeading badge={badge} heading={heading} subheading={subheading} />
      <div class="space-y-4">
        {days.map((day) => (
          <div class="bg-white rounded-2xl p-6 border-l-4" style="border-color: #FDEA01;">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <span class="badge badge-navy mb-2 inline-flex">{day.day}</span>
                <h3 class="text-lg font-black" style="color: #1A2744;">{day.title}</h3>
              </div>
              <span class="text-xs text-gray-400 mt-1 text-right">{day.vehicle}</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {day.stops.map((stop) => (
                <span class="text-xs px-3 py-1.5 rounded-full border" style="border-color: #E5E7EB; color: #374151;">{stop}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      {cta && (
        <div class="mt-8 text-center">
          <a href={withBase(cta.href)} class="btn-primary">{cta.label}</a>
        </div>
      )}
    </div>
  </div>
</section>
