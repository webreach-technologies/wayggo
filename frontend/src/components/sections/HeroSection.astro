---
import { MessageSquare, Users } from '@lucide/astro';
import imgCorporate  from '../../assets/tourtype/Corporate & Convention Travel.png';
import imgEducation  from '../../assets/tourtype/Educational & Student Tours.png';
import imgReligious  from '../../assets/tourtype/Religious & Pilgrimage Groups.png';
import imgSightseeing from '../../assets/tourtype/Sightseeing & City Tours.png';
import imgSports     from '../../assets/tourtype/Sports Teams & Fan Group Travel.png';
import imgWedding    from '../../assets/tourtype/Wedding & Special Events.png';
import { withBase } from '../../lib/url';
import HeroCarousel3D from './HeroCarousel3D.astro';

interface Props {
  badge?: string;
  heading?: string;
  headingHighlight?: string;
  headingEnd?: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  badge = "Your Gateway to Great Destinations",
  heading = "North America's",
  headingEnd = "Group Bus Rental Network",
  subheading = "500+ vetted operators across every major US & Canadian city. One call. Every vehicle type.",
  primaryCta = { label: "Request a Quote", href: "/contact" },
  secondaryCta = { label: "Become a Partner", href: "/portal" },
} = Astro.props;

const slides = [
  { img: imgCorporate,   label: "Corporate & Convention",   color: "#4A9EFF",
    desc: "Shuttles and coaches for conferences, conventions and executive groups, timed to every session and airport run." },
  { img: imgSightseeing, label: "Sightseeing & City Tours", color: "#FF7A45",
    desc: "Motorcoaches and minibuses for city tours and multi-day itineraries, with drivers who know the route." },
  { img: imgWedding,     label: "Wedding & Special Events", color: "#FF6B9D",
    desc: "Guest shuttles and party buses that move everyone between venues and keep the celebration on schedule." },
  { img: imgSports,      label: "Sports & Fan Travel",      color: "#7ED321",
    desc: "Team buses and fan coaches for game days, tournaments and away trips, with room for the gear." },
  { img: imgEducation,   label: "Educational & Student",    color: "#F5A623",
    desc: "Vetted coaches for school trips, student exchanges and campus tours, driven by operators used to young groups." },
  { img: imgReligious,   label: "Religious & Pilgrimage",   color: "#BD9FE0",
    desc: "Respectful, punctual transportation for pilgrimages, church groups and faith-based tours." },
];

const cyclingWords = [
  "Most Trusted",
  "Most Reliable",
  "Most Connected",
  "Most Flexible",
  "Most Efficient",
];
---

<section
  class="hero-section relative flex items-center diagonal-lines overflow-hidden"
  style="background-color: #1A2744;"
>
  <div class="absolute top-0 right-0 w-150 h-150 rounded-full opacity-10 blur-3xl pointer-events-none"
    style="background: radial-gradient(circle, #FDEA01 0%, transparent 70%); transform: translate(30%, -30%);"/>
  <div class="absolute bottom-0 left-0 w-100 h-100 rounded-full opacity-5 blur-3xl pointer-events-none"
    style="background: radial-gradient(circle, #FDEA01 0%, transparent 70%); transform: translate(-30%, 30%);"/>

  <div class="container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-16 items-center py-12 lg:py-0">

      <!-- LEFT -->
      <div>
        <div class="section-label-white mb-5 animate-fade-up">{badge}</div>

        <h1
          class="text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-black leading-tight mb-6 animate-fade-up delay-100 text-white"
        >
          {heading}<br />
          <span class="word-track" aria-live="polite">
            <span id="heroWord" style="color:#FDEA01;">{cyclingWords[0]}</span>
          </span><br />
          {headingEnd}
        </h1>

        <p class="font-subheading text-base sm:text-lg text-white/60 max-w-md mb-8 leading-relaxed animate-fade-up delay-200">
          {subheading}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 animate-fade-up delay-300">
          <a href={withBase(primaryCta.href)} class="btn-primary">
            <MessageSquare size={16} stroke-width={2.5} />
            {primaryCta.label}
          </a>
          <a href={withBase(secondaryCta.href)} class="btn-outline-white">
            <Users size={16} stroke-width={2.5} />
            {secondaryCta.label}
          </a>
        </div>
      </div>

      <!-- RIGHT: 3D card carousel -->
      <HeroCarousel3D slides={slides} />

    </div>
  </div>
</section>

<style>
  /* Full screen below the header; a little shorter on desktop */
  .hero-section { min-height: calc(100vh - 108px); }
  @media (min-width: 1024px) {
    .hero-section { min-height: calc(100vh - 148px); }
  }

  /* ── Cycling word track ── */
  .word-track {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    line-height: inherit;
  }
  #heroWord {
    display: inline-block;
    line-height: inherit;
    will-change: transform, opacity;
  }
</style>

<script define:vars={{ cyclingWords }}>
  /* ── Word cycler ── */
  const el = document.getElementById("heroWord");
  if (el) {
    const DUR = 420;
    let idx = 0, busy = false;
    el.style.transition = `transform ${DUR}ms cubic-bezier(0.4,0,0.2,1), opacity ${DUR}ms ease`;
    function cycle() {
      if (busy) return;
      busy = true;
      el.style.transform = "translateY(-120%)";
      el.style.opacity   = "0";
      setTimeout(() => {
        el.style.transition = "none";
        el.style.transform  = "translateY(120%)";
        el.style.opacity    = "0";
        idx = (idx + 1) % cyclingWords.length;
        el.textContent = cyclingWords[idx];
        void el.offsetWidth;
        el.style.transition = `transform ${DUR}ms cubic-bezier(0.4,0,0.2,1), opacity ${DUR}ms ease`;
        el.style.transform  = "translateY(0)";
        el.style.opacity    = "1";
        setTimeout(() => { busy = false; }, DUR);
      }, DUR);
    }
    const cycleTimer = setInterval(cycle, 6000);
    // ClientRouter re-runs this inline script on each visit; clear the old timer when leaving
    document.addEventListener("astro:before-swap", () => clearInterval(cycleTimer), { once: true });
  }
</script>
