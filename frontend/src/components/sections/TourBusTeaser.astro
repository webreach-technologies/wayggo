---
import { ArrowRight } from "@lucide/astro";
import { withBase } from "../../lib/url";
import { loadTourBusCards } from "../../lib/tourBus";
import TourBusGrid from "../tour-bus/TourBusGrid.astro";

interface Props {
  badge?: string;
  heading?: string;
  subheading?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
  /** Max number of tour bus cards to show. Defaults to 3. */
  limit?: number;
}

const {
  badge = "Rent Tour Bus",
  heading = "Explore Ready-to-Book Group Tours",
  subheading = "Some journeys begin with a destination. WAYGGO's tour bus collection brings together transportation options for groups visiting notable attractions and destinations across North America. Explore individual tour pages to understand the destination, group experience, transportation considerations, and available options.",
  viewAllHref = "/tour-bus",
  viewAllLabel = "View All Tour Locations",
  limit = 3,
} = Astro.props;

const allTourBuses = await loadTourBusCards();
const tourBuses = allTourBuses.slice(0, limit);

const headingLines = heading.split("\n");
const subheadingParagraphs = subheading.split("\n");
---

<section class="py-14" style="background: white;">
  <div class="container">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-14 gap-4">
      <div>
        <span class="section-label">{badge}</span>
        <h2 class="text-4xl lg:text-5xl font-black mt-5"
          style="color: #1A2744;">
          {headingLines.map((line, i) => (
            <>
              {line}
              {i < headingLines.length - 1 && <br />}
            </>
          ))}
        </h2>
        {subheadingParagraphs.map((p) => (
          <p class="font-subheading text-gray-600 leading-relaxed max-w-4xl mt-4">{p}</p>
        ))}
      </div>
      <a href={withBase(viewAllHref)}
        class="self-start lg:self-auto shrink-0 flex items-center gap-2 font-bold text-sm uppercase tracking-widest transition-all hover:gap-4"
        style="color: #1A2744;">
        {viewAllLabel}
        <ArrowRight size={16} stroke-width={2.5} />
      </a>
    </div>

    {tourBuses.length > 0 && <TourBusGrid cards={tourBuses} />}

    {tourBuses.length === 0 && (
      <p class="text-center text-gray-500 text-sm py-10">
        Tour bus itineraries are coming soon — check back shortly.
      </p>
    )}
  </div>
</section>
