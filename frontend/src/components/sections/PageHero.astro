---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBase } from "../../lib/url";

interface Props {
  badge?: string;
  heading: string;
  subheading?: string;
  size?: "sm" | "md" | "lg";
  align?: "left" | "center";
  /** Optional background photo, rendered faded behind the copy. */
  image?: ImageMetadata;
  imageAlt?: string;
  cta?: { label: string; href: string };
}

const {
  badge,
  heading,
  subheading,
  size = "md",
  align = "left",
  image,
  imageAlt = "",
  cta,
} = Astro.props;

const paddingMap = { sm: "py-16", md: "py-24", lg: "py-32" };
const headingMap = { sm: "text-4xl lg:text-5xl", md: "text-5xl lg:text-6xl", lg: "text-5xl lg:text-7xl" };
const alignClass = align === "center" ? "text-center mx-auto" : "";
const maxWidthClass = align === "center" ? "max-w-3xl mx-auto" : "max-w-3xl";
---

<section class={`relative overflow-hidden ${paddingMap[size]}`} style="background-color: #1A2744;">
  {image && (
    <Image
      src={image}
      alt={imageAlt}
      width={1600}
      height={600}
      quality={25}
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover opacity-25"
    />
  )}
  <div class="absolute inset-0 diagonal-lines pointer-events-none" />
  <div class="container relative z-10">
    <div class={maxWidthClass}>
      {badge && (
        <span class={`section-label-white mb-5 inline-flex ${alignClass}`}>{badge}</span>
      )}
      <h1
        class={`${headingMap[size]} font-black text-white mb-5 ${alignClass}`}
        set:html={heading}
      />
      {subheading && (
        <p
          class={`font-subheading text-white/65 text-lg leading-relaxed ${alignClass}`}
          set:html={subheading}
        />
      )}
      {cta && (
        <div class={`mt-8 ${align === "center" ? "text-center" : ""}`}>
          <a href={withBase(cta.href)} class="btn-primary">{cta.label}</a>
        </div>
      )}
    </div>
  </div>
</section>
