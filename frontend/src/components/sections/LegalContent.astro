---
// Long-form text container for the legal pages (privacy, terms, cookies).
---

<section class="py-16" style="background: white;">
  <div class="container">
    <div class="legal-content max-w-3xl mx-auto">
      <slot />
    </div>
  </div>
</section>

<style>
  .legal-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.25;
    color: var(--color-navy);
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--color-yellow);
  }
  .legal-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 900;
    color: var(--color-navy);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .legal-content :global(h4) {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-navy);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .legal-content :global(p) {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #4B5563;
    margin-bottom: 1rem;
  }
  .legal-content :global(strong) {
    color: var(--color-navy);
  }
  .legal-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .legal-content :global(li) {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #4B5563;
  }
  .legal-content :global(li::marker) {
    color: var(--color-navy);
  }
  .legal-content :global(a) {
    color: var(--color-navy);
    font-weight: 700;
    text-decoration: underline;
  }
  .legal-content :global(> :first-child) {
    margin-top: 0;
  }
</style>
