---
interface Props {
  badge?: string;
  /** Pass `false` to render the paragraphs only. */
  heading?: string | false;
  /** Separate paragraphs with "\n". */
  paragraph?: string;
}

const {
  badge,
  heading = "Your ground transportation partner for group travel across North America.",
  paragraph = "WAYGGO connects travel professionals and group organizers with a network of transportation operators across the United States and Canada, helping coordinate the vehicles, people, and movement behind the journey.",
} = Astro.props;

const paragraphs = paragraph.split("\n");
---

<section style="background: #FDEA01;">
  <div class="container">
    <div class="py-10 text-center">
      {badge && <span class="section-label mb-4">{badge}</span>}
      {heading && (
        <h2 class="text-2xl lg:text-3xl font-black leading-tight mx-auto max-w-4xl mb-4"
          style="color: #1A2744;">
          {heading}
        </h2>
      )}
      <div class="space-y-3">
        {paragraphs.map((p) => (
          <p class="text-lg lg:text-base font-bold leading-relaxed mx-auto max-w-4xl"
            style="color: rgba(26,39,68,0.7);">
            {p}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>
