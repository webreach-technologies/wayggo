---
import { ArrowRight } from "@lucide/astro";
import { withBase } from "../../lib/url";

interface Category {
  name: string;
  tagline: string;
  desc: string;
  href: string;
  cities: string[];
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<section class="py-14" style="background-color: #F9F7F2;">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <a
          href={withBase(cat.href)}
          class="group bg-white rounded-2xl overflow-hidden card-hover border-2 border-transparent hover:border-yellow transition-all duration-300"
        >
          <div class="p-7 pb-0">
            <h2 class="text-xl font-black mb-1" style="color: #1A2744;">{cat.name}</h2>
            <p class="text-xs font-semibold italic text-gray-400 mb-4">{cat.tagline}</p>
            <p class="text-sm text-gray-500 leading-relaxed">{cat.desc}</p>
          </div>

          <div class="p-7 pt-5">
            <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">Popular Destinations</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {cat.cities.map((city) => (
                <span class="text-xs px-2.5 py-1 rounded-full" style="background-color: #F9F7F2; color: #1A2744; font-weight: 500;">
                  {city}
                </span>
              ))}
            </div>
            <div class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest group-hover:gap-3 transition-all"
              style="color: #1A2744;">
              Explore Service
              <ArrowRight size={14} stroke-width={2.5} />
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
