---
// Navy two-column panel: copy on the left, stat cards on the right.
// Same look as PartnerCTA, without the buttons.
interface Stat {
  value: string;
  label: string;
}

interface Props {
  badge?: string;
  heading: string;
  /** Second heading line, shown in yellow. */
  headingHighlight?: string;
  /** Separate paragraphs with "\n". */
  text?: string;
  stats: Stat[];
  /** Small print under the stat cards. */
  note?: string;
}

const { badge, heading, headingHighlight, text, stats, note } = Astro.props;

const paragraphs = text ? text.split("\n") : [];
---

<section class="relative overflow-hidden" style="background: #1A2744;">
  <!-- Texture -->
  <div class="absolute inset-0 pointer-events-none diagonal-lines opacity-40"></div>
  <!-- Glow -->
  <div class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 50% 60%, rgba(255,208,0,0.07) 0%, transparent 65%);"></div>

  <div class="container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center py-14">

      <!-- Left: Copy -->
      <div>
        {badge && <span class="section-label-white mb-6 inline-flex">{badge}</span>}
        <h2 class="text-3xl lg:text-4xl font-black mb-6 text-white leading-tight">
          {heading}
          {headingHighlight && (
            <>
              <br />
              <span style="color: #FDEA01;">{headingHighlight}</span>
            </>
          )}
        </h2>
        {paragraphs.length > 0 && (
          <div class="space-y-4">
            {paragraphs.map((p) => (
              <p class="font-subheading text-base leading-relaxed" style="color: rgba(255,255,255,0.55);">{p}</p>
            ))}
          </div>
        )}
      </div>

      <!-- Right: Stat cards -->
      <div>
        <div class="grid grid-cols-2 gap-4">
          {stats.map((s) => (
            <div class="rounded-2xl p-5 sm:p-7 text-center" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);">
              <div class="text-3xl sm:text-4xl lg:text-5xl font-black leading-none mb-3 whitespace-nowrap" style="color: #FDEA01;">{s.value}</div>
              <p class="text-xs font-bold uppercase tracking-widest leading-relaxed" style="color: rgba(255,255,255,0.7);">{s.label}</p>
            </div>
          ))}
        </div>
        {note && <p class="text-xs leading-relaxed mt-5 text-center" style="color: rgba(255,255,255,0.35);">{note}</p>}
      </div>
    </div>
  </div>
</section>
