---
import { FileText, Clock, ArrowRight, type AstroComponent } from "@lucide/astro";

interface Step {
  num: string;
  icon: AstroComponent;
  title: string;
  desc: string;
}

interface Props {
  badge?: string;
  heading?: string;
  subheading?: string;
  steps?: Step[];
}

const {
  badge = "Straightforward Process",
  heading = "From Itinerary to Arrival",
  subheading = "Group transportation should not require you to become a transportation expert. WAYGGO Charters keeps the process straightforward.",
  steps = [
    {
      num: "01",
      icon: FileText,
      title: "Share Your Itinerary",
      desc: "Tell us about your group, travel dates, destinations, cities, passenger count, and the purpose of the trip. The more we understand about the journey, the better we can coordinate the transportation around it.",
    },
    {
      num: "02",
      icon: Clock,
      title: "We Coordinate the Transportation",
      desc: "Our operations team works through the WAYGGO network to identify an appropriate transportation operator and vehicle for the itinerary, then provides the details needed to move the trip forward.",
    },
    {
      num: "03",
      icon: ArrowRight,
      title: "Your Group Moves",
      desc: "Once the transportation is arranged, the group can focus on the journey itself. From scheduled departures to planned stops and destination changes, the transportation is organized around the itinerary rather than the other way around.",
    },
  ],
} = Astro.props;
---

<section class="py-14" style="background-color: white;">
  <div class="container">
    <div class="text-center mb-14">
      <span class="section-label">{badge}</span>
      <h2
        class="text-4xl lg:text-5xl font-black mt-4 mb-4"
        style="color: #1A2744;"
      >
        {heading}
      </h2>
      <p class="font-subheading text-base text-gray-500 max-w-xl mx-auto">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {steps.map((step) => {
        const StepIcon = step.icon;
        return (
        <div class="relative pl-0">
          <div
            class="text-8xl font-black absolute -top-4 -left-2 pointer-events-none select-none"
            style="color: #FDEA01; opacity: 0.12;"
          >
            {step.num}
          </div>
          <div class="relative">
            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5"
              style="background-color: #FDEA01;"
            >
              <StepIcon size={24} color="#1A2744" stroke-width={2.5} />
            </div>
            <h3
              class="text-xl font-black mb-3"
              style="color: #1A2744;"
            >
              {step.title}
            </h3>
            <p class="text-gray-500 leading-relaxed">
              {step.desc}
            </p>
          </div>
        </div>
        );
      })}
    </div>
  </div>
</section>
