---
import { FileText, Clock, ArrowRight, type AstroComponent } from "@lucide/astro";

interface Step {
  num: string;
  icon: AstroComponent;
  title: string;
  desc: string;
}

interface Props {
  badge?: string;
  heading?: string;
  subheading?: string;
  steps?: Step[];
}

const {
  badge = "Simple Process",
  heading = "Seamless From Start to Finish",
  subheading = "We've built a frictionless process so you spend less time on logistics and more time designing unforgettable tours.",
  steps = [
    {
      num: "01",
      icon: FileText,
      title: "Submit Your Itinerary",
      desc: "Share your group size, travel dates, cities, and tour purpose. Our smart quote form captures everything we need to get started immediately.",
    },
    {
      num: "02",
      icon: Clock,
      title: "We Match & Confirm",
      desc: "Within 24 hours, our operations team sources the best-fit operator and vehicle from our vetted network and sends you a detailed proposal.",
    },
    {
      num: "03",
      icon: ArrowRight,
      title: "Your Group Moves",
      desc: "Professionally driven, on-time arrivals at every stop. We monitor in real-time and handle any on-the-ground changes so you never worry.",
    },
  ],
} = Astro.props;
---

<section class="py-24" style="background-color: white;">
  <div class="container">
    <div class="text-center mb-16">
      <span class="section-label">{badge}</span>
      <h2
        class="text-4xl lg:text-5xl font-black mt-4 mb-4"
        style="color: #1A2744;"
      >
        {heading}
      </h2>
      <p class="font-subheading text-base text-gray-500 max-w-xl mx-auto">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {steps.map((step) => {
        const StepIcon = step.icon;
        return (
        <div class="relative pl-0">
          <div
            class="text-8xl font-black absolute -top-4 -left-2 pointer-events-none select-none"
            style="color: #FDEA01; opacity: 0.12;"
          >
            {step.num}
          </div>
          <div class="relative">
            <div
              class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5"
              style="background-color: #FDEA01;"
            >
              <StepIcon size={24} color="#1A2744" stroke-width={2.5} />
            </div>
            <h3
              class="text-xl font-black mb-3"
              style="color: #1A2744;"
            >
              {step.title}
            </h3>
            <p class="text-gray-500 leading-relaxed">
              {step.desc}
            </p>
          </div>
        </div>
        );
      })}
    </div>
  </div>
</section>
