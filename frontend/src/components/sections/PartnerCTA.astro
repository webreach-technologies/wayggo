---
import { withBase } from '../../lib/url';

interface TrustCard {
  title: string;
  desc: string;
}

interface Props {
  badge?: string;
  heading?: string;
  headingHighlight?: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  trustCards?: TrustCard[];
}

const {
  badge = "Join Our Partner Network",
  heading = "Ready to Simplify Your",
  headingHighlight = "North American Tours?",
  subheading = "When transportation is spread across several cities, destinations, and vehicle requirements, having the right transportation partner can make a meaningful difference.\nWAYGGO works with travel professionals and group organizers to coordinate ground transportation across North America through a single relationship.\nWhether you have an itinerary ready to quote or are looking for a transportation partner for future group travel, we're ready to start the conversation.",
  primaryCta = { label: "Request a Quote — It's Free", href: "/contact" },
  secondaryCta = { label: "Register as a Travel Partner", href: "/portal" },
  trustCards = [
    { title: "No Registration Fee",          desc: "Become a WAYGGO partner without registration or onboarding fees." },
    { title: "Responsive Coordination",      desc: "Get a transportation team focused on your itinerary and its requirements." },
    { title: "Dedicated Account Management", desc: "Maintain a consistent point of contact for your transportation operations." },
    { title: "Flexible Invoicing",           desc: "Explore consolidated billing and other invoicing arrangements available for qualifying partner relationships." },
  ],
} = Astro.props;

const subheadingParagraphs = subheading.split("\n");
---

<section class="relative overflow-hidden" style="background: #1A2744;">
  <!-- Texture -->
  <div class="absolute inset-0 pointer-events-none diagonal-lines opacity-40"></div>
  <!-- Glow -->
  <div class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse at 50% 60%, rgba(255,208,0,0.07) 0%, transparent 65%);"></div>

  <div class="container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center py-14">

      <!-- Left: Copy -->
      <div>
        <span class="section-label-white mb-6 inline-flex">{badge}</span>
        <h2 class="text-4xl lg:text-5xl font-black mb-6 text-white leading-tight"
          style="">
          {heading}<br />
          <span style="color: #FDEA01;">{headingHighlight}</span>
        </h2>
        <div class="space-y-4 mb-10">
          {subheadingParagraphs.map((p) => (
            <p class="font-subheading text-base leading-relaxed"
              style="color: rgba(255,255,255,0.55);">
              {p}
            </p>
          ))}
        </div>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-4">
          <a href={withBase(primaryCta.href)} class="btn-primary">{primaryCta.label}</a>
          <a href={withBase(secondaryCta.href)} class="btn-outline-white">{secondaryCta.label}</a>
        </div>
      </div>

      <!-- Right: Trust checklist cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {trustCards.map((item) => (
          <div class="rounded-2xl p-5" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center mb-3 text-sm font-black"
              style="background: #FDEA01; color: #1A2744; ">
              ✓
            </div>
            <h4 class="text-sm font-black mb-1.5 text-white" style="">{item.title}</h4>
            <p class="text-xs leading-relaxed" style="color: rgba(255,255,255,0.45);">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
