---
// 3D stacked-card carousel for the homepage hero.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ChevronLeft, ChevronRight } from '@lucide/astro';

interface Slide {
  img: ImageMetadata;
  label: string;
  color: string;
  desc: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;

// Arrows + dots hidden for now; set true to show them again
const SHOW_CONTROLS = false;

function getSlot(i: number, total: number): string {
  let diff = i;
  if (diff > total / 2) diff -= total;
  if (diff < -total / 2) diff += total;
  return Math.abs(diff) > 2 ? 'hidden' : String(diff);
}
---

<div class="c3d-wrap">
  <div class="c3d-stage" id="c3dStage">
    {slides.map((s, i) => (
      <div class="c3d-card" data-index={i} data-slot={getSlot(i, slides.length)}>
        <Image
          src={s.img}
          quality={50}
          width={880}
          height={629}
          alt={s.label}
          class="c3d-img"
          draggable="false"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
        />
        <div class="c3d-overlay"></div>
        <div class="c3d-shade"></div>
        <div class="c3d-chip">
          {s.label}
        </div>
        <p class="c3d-desc">{s.desc}</p>
      </div>
    ))}
  </div>

  {SHOW_CONTROLS && (
  <div class="c3d-controls">
    <button type="button" class="c3d-arrow" id="c3dPrev" aria-label="Previous slide">
      <ChevronLeft size={20} />
    </button>
    <div class="c3d-bullets">
      {slides.map((s, i) => (
        <button type="button" class:list={["c3d-bullet", { "is-active": i === 0 }]} data-index={i} aria-label={`Go to slide ${i + 1}: ${s.label}`}></button>
      ))}
    </div>
    <button type="button" class="c3d-arrow" id="c3dNext" aria-label="Next slide">
      <ChevronRight size={20} />
    </button>
  </div>
  )}
</div>

<style>
  .c3d-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 3D viewport — sized from its own width so cards stay centred at any screen size */
  .c3d-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    perspective: 1200px;
    perspective-origin: 50% 50%;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  @media (min-width: 1024px) {
    .c3d-stage { aspect-ratio: 16 / 10; }
  }

  /* Landscape card; every slot transform starts with translate(-50%, -50%)
     to centre it, and side offsets are % of the card's own width */
  .c3d-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 78%;
    aspect-ratio: 4 / 3;
    border-radius: 1.25rem;
    overflow: hidden;
    background: #0d1528;
    /* Only transform + opacity animate, so each slide change runs on the GPU
       compositor without repainting the cards every frame */
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
    backface-visibility: hidden;
    transform-style: preserve-3d;
    cursor: pointer;
  }
  @media (min-width: 1024px) {
    .c3d-card { width: 80%; aspect-ratio: 7 / 5; }
  }

  .c3d-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  .c3d-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(11,19,41,0.4) 0%, rgba(11,19,41,0.15) 35%, rgba(11,19,41,0.95) 100%);
    pointer-events: none;
  }
  /* Darkens side cards; fading its opacity is far cheaper than animating
     filter: brightness()/blur() on the whole card */
  .c3d-shade {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity;
  }

  .c3d-chip {
    position: absolute;
    top: 14px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(15,23,42,0.88);
    border: 1px solid rgba(51,65,85,0.6);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #e2e8f0;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .c3d-chip { top: 18px; right: 18px; font-size: 11px; padding: 6px 14px; }
  }

  .c3d-desc {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.4;
    color: #e2e8f0;
    text-shadow: 0 1px 6px rgba(0,0,0,0.6);
  }
  @media (min-width: 640px) {
    .c3d-desc { left: 20px; right: 20px; bottom: 18px; font-size: 0.875rem; }
  }

  /* Slot positions (mobile first: one card peeks on each side) */
  .c3d-card[data-slot="0"] {
    transform: translate(-50%, -50%) translate3d(0, 0, 60px) rotateY(0deg) scale(1);
    opacity: 1;
    z-index: 30;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7), 0 0 30px rgba(253,234,1,0.15);
    border: 1px solid rgba(255,255,255,0.15);
  }
  .c3d-card[data-slot="-1"],
  .c3d-card[data-slot="1"] {
    opacity: 0.65;
    z-index: 20;
    box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.08);
  }
  .c3d-card[data-slot="-1"] .c3d-shade,
  .c3d-card[data-slot="1"] .c3d-shade { opacity: 0.3; }
  .c3d-card[data-slot="-2"] .c3d-shade,
  .c3d-card[data-slot="2"] .c3d-shade { opacity: 0.5; }
  .c3d-card[data-slot="-1"] { transform: translate(-50%, -50%) translate3d(-26%, 0, -30px) rotateY(15deg) scale(0.82); }
  .c3d-card[data-slot="1"]  { transform: translate(-50%, -50%) translate3d(26%, 0, -30px) rotateY(-15deg) scale(0.82); }
  .c3d-card[data-slot="-2"],
  .c3d-card[data-slot="2"] {
    opacity: 0;
    pointer-events: none;
    z-index: 10;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .c3d-card[data-slot="-2"] { transform: translate(-50%, -50%) translate3d(-50%, 0, -100px) rotateY(25deg) scale(0.7); }
  .c3d-card[data-slot="2"]  { transform: translate(-50%, -50%) translate3d(50%, 0, -100px) rotateY(-25deg) scale(0.7); }
  .c3d-card[data-slot="hidden"] {
    transform: translate(-50%, -50%) translate3d(0, 0, -200px) scale(0.5);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .c3d-card[data-slot="-1"] { transform: translate(-50%, -50%) translate3d(-36%, 0, -20px) rotateY(15deg) scale(0.85); }
    .c3d-card[data-slot="1"]  { transform: translate(-50%, -50%) translate3d(36%, 0, -20px) rotateY(-15deg) scale(0.85); }
    .c3d-card[data-slot="-2"],
    .c3d-card[data-slot="2"]  { opacity: 0.3; }
    .c3d-card[data-slot="-2"] { transform: translate(-50%, -50%) translate3d(-52%, 0, -100px) rotateY(25deg) scale(0.72); }
    .c3d-card[data-slot="2"]  { transform: translate(-50%, -50%) translate3d(52%, 0, -100px) rotateY(-25deg) scale(0.72); }
  }
  /* Desktop cards are wider, so pull the far cards in to keep them out of the text column */
  @media (min-width: 1024px) {
    .c3d-card[data-slot="-2"] { transform: translate(-50%, -50%) translate3d(-46%, 0, -100px) rotateY(25deg) scale(0.72); }
    .c3d-card[data-slot="2"]  { transform: translate(-50%, -50%) translate3d(46%, 0, -100px) rotateY(-25deg) scale(0.72); }
  }

  @media (prefers-reduced-motion: reduce) {
    .c3d-card, .c3d-shade { transition: none; }
  }

  /* Controls */
  .c3d-controls {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .c3d-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    border-radius: 999px;
    background: rgba(30,41,59,0.8);
    border: 1px solid #334155;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .c3d-arrow:hover { background: #FDEA01; color: #1A2744; }
  .c3d-arrow:active { transform: scale(0.95); }

  .c3d-bullets {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .c3d-bullet {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #334155;
    cursor: pointer;
    transition: width 0.3s, background 0.3s;
  }
  .c3d-bullet:hover { background: #64748b; }
  .c3d-bullet.is-active { width: 28px; background: #FDEA01; }
</style>

<script>
  // With the site's <ClientRouter /> (View Transitions) enabled, script tags only
  // execute once per browser session, so set the carousel up on every page load
  // and tear it down (timer, window/document listeners, observer) before leaving.
  function initHeroCarousel3D() {
    const stage = document.getElementById("c3dStage");
    if (!stage || stage.dataset.ready) return;
    stage.dataset.ready = "1";
    const cards = Array.from(stage.querySelectorAll<HTMLElement>(".c3d-card"));
    const bullets = Array.from(document.querySelectorAll<HTMLElement>(".c3d-bullet"));
    const total = cards.length;
    if (!total) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let hovering = false;
    let inView = true;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const abort = new AbortController();
    const signal = abort.signal;

    function update() {
      cards.forEach((card, i) => {
        let diff = i - current;
        if (diff > total / 2) diff -= total;
        if (diff < -total / 2) diff += total;
        card.dataset.slot = Math.abs(diff) > 2 ? "hidden" : String(diff);
      });
      bullets.forEach((b, i) => b.classList.toggle("is-active", i === current));
    }

    function goTo(i: number) {
      current = (i + total) % total;
      update();
      start();
    }
    const next = () => goTo(current + 1);
    const prev = () => goTo(current - 1);

    function stop() { if (timer) clearInterval(timer); timer = null; }
    // Autoplay only while the carousel is on screen, the tab is visible and it isn't hovered
    function start() {
      stop();
      if (reduceMotion || hovering || !inView || document.hidden) return;
      timer = setInterval(next, 4500);
    }

    cards.forEach((card, i) => card.addEventListener("click", () => { if (i !== current) goTo(i); }));
    bullets.forEach((b, i) => b.addEventListener("click", () => goTo(i)));
    document.getElementById("c3dPrev")?.addEventListener("click", prev);
    document.getElementById("c3dNext")?.addEventListener("click", next);

    stage.addEventListener("mouseenter", () => { hovering = true; stop(); });
    stage.addEventListener("mouseleave", () => { hovering = false; start(); });
    document.addEventListener("visibilitychange", start, { signal });
    const observer = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; start(); });
    observer.observe(stage);

    // Mouse drag / touch swipe
    let dragging = false;
    let startX = 0;
    function endSwipe(x: number) {
      if (!dragging) return;
      dragging = false;
      const dx = x - startX;
      if (dx < -40) next();
      else if (dx > 40) prev();
    }
    stage.addEventListener("mousedown", (e) => { dragging = true; startX = e.clientX; stop(); });
    window.addEventListener("mouseup", (e) => endSwipe(e.clientX), { signal });
    stage.addEventListener("touchstart", (e) => { dragging = true; startX = e.touches[0].clientX; stop(); }, { passive: true });
    stage.addEventListener("touchend", (e) => { endSwipe(e.changedTouches[0].clientX); start(); }, { passive: true });

    document.addEventListener("astro:before-swap", () => {
      stop();
      observer.disconnect();
      abort.abort();
    }, { once: true });

    update();
    start();
  }

  document.addEventListener("astro:page-load", initHeroCarousel3D);
</script>
