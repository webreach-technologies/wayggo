---
import PackagesListingPage from "../components/packages/PackagesListingPage.astro";
import { loadPackageCards, getBuckets, filterCards, PAGE_SIZE } from "../lib/packages";

const cards = await loadPackageCards();
const bucket = getBuckets()[0]; // the "all packages" bucket
const bucketCards = filterCards(cards, bucket);
const totalPages = Math.max(1, Math.ceil(bucketCards.length / PAGE_SIZE));
const pageCards = bucketCards.slice(0, PAGE_SIZE);
---

<PackagesListingPage
  bucket={bucket}
  page={1}
  totalPages={totalPages}
  pageCards={pageCards}
  totalInBucket={bucketCards.length}
/>
