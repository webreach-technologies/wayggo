---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { Van, Bus, BusFront, Plus } from "@lucide/astro";

const vehicleIconComponents: Record<string, typeof Van> = {
  van: Van,
  bus: Bus,
  fullbus: BusFront,
  motorcoach: BusFront,
};

const usStates = [
  "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "GA",
  "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD",
  "MA", "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ",
  "NM", "NY", "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC",
  "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV", "WI", "WY", "DC",
];

const caProvinces = [
  "AB", "BC", "MB", "NB", "NL", "NS", "ON", "PE", "QC", "SK", "NT", "NU", "YT",
];

const packages = [
  {
    id: "nyc-icons",
    detailHref: "/packages/nyc-icons",
    name: "New York City Icons",
    days: 5,
    size: "8–20 pax",
    price: "$180",
    vehicle: "Luxury Van or Minibus",
    iconKey: "bus",
    image: null,
    gradientStyle: "linear-gradient(135deg, #1e293b, #334155)",
    country: "USA",
    state: "NY",
    cities: ["New York City"],
    highlights: ["Times Square & Broadway", "Statue of Liberty Cruise", "Central Park Guided Tour", "9/11 Memorial & Museum", "Empire State Building", "Brooklyn Bridge Walk"],
    included: ["Minibus/van for all 5 days", "Licensed driver", "Airport transfers", "Hotel pickups daily"],
  },
];
---

<BaseLayout
  title="Group Tour Packages — WAYGGO North America Ground Transportation"
  description="Ready-to-book group tour packages for international travelers across the USA and Canada. Motorcoaches, buses, and vans included."
>

  <!-- Hero -->
  <section class="py-24 diagonal-lines" style="background-color: #1A2744;">
    <div class="container">
      <div class="max-w-3xl">
        <span class="section-label-white mb-5 inline-flex">{packages.length} Ready-to-Book Package{packages.length === 1 ? "" : "s"}</span>
        <h1 class="text-5xl lg:text-6xl font-black text-white mb-5" style="">
          Group Tour Packages<br />
          <span style="color: #FDEA01;">Across North America</span>
        </h1>
        <p class="text-white/65 text-lg leading-relaxed max-w-2xl" style="">
          Curated ground transportation packages for international tour operators. All vehicles, all drivers, all transfers — included. Request any package or mix and match cities for a custom itinerary.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter bar -->
  <div style="background-color: #F9F7F2; border-bottom: 1px solid #E5E7EB;">
    <div class="container">
      <div class="flex overflow-x-auto md:flex-wrap md:justify-center gap-3 py-4">
        <button
          class="filter-btn shrink-0 px-6 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all"
          style="background-color: #1A2744; color: white; border: 2px solid #1A2744;"
          onclick="showAll()"
          id="btn-all"
        >
          All Packages
        </button>
        <button
          class="filter-btn shrink-0 px-6 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all"
          style="background-color: transparent; color: #1A2744; border: 2px solid #E5E7EB;"
          onclick="showCountry('USA')"
          id="btn-usa"
        >
          USA
        </button>
        <button
          class="filter-btn shrink-0 px-6 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest transition-all"
          style="background-color: transparent; color: #1A2744; border: 2px solid #E5E7EB;"
          onclick="showCountry('Canada')"
          id="btn-canada"
        >
          Canada
        </button>
      </div>

      <!-- State / Province filter rows -->
      <div id="state-bar-USA" class="flex flex-wrap justify-center gap-2 pb-4" style="display: none;">
        {usStates.map((s) => (
          <button class="state-btn shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all" style="background-color: transparent; color: #1A2744; border: 1.5px solid #E5E7EB;" data-country="USA" data-state={s}>
            {s}
          </button>
        ))}
      </div>

      <div id="state-bar-Canada" class="flex flex-wrap justify-center gap-2 pb-4" style="display: none;">
        {caProvinces.map((s) => (
          <button class="state-btn shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider transition-all" style="background-color: transparent; color: #1A2744; border: 1.5px solid #E5E7EB;" data-country="Canada" data-state={s}>
            {s}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Packages -->
  <section class="py-16 lg:py-20" style="background-color: white;" id="section-packages">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="packages-grid">
        {packages.map((pkg) => (
          <div class="package-card bg-white rounded-2xl overflow-hidden card-hover border border-gray-100 flex flex-col" data-country={pkg.country} data-state={pkg.state}>
            <!-- Card image / header -->
            <div class="relative h-44 overflow-hidden shrink-0">
              {pkg.image ? (
                <Image
                  src={pkg.image}
                  alt={pkg.name}
                  width={480}
                  height={176}
                  class="absolute inset-0 w-full h-full object-cover"
                />
              ) : (
                <div class="absolute inset-0" style={{ background: pkg.gradientStyle }} />
              )}
              {pkg.image && <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 60%);" />}
              <!-- Overlay content -->
              <div class="relative z-10 h-full p-5 flex flex-col justify-between">
                <div class="flex justify-between items-start">
                  <span class="badge badge-navy" style="background-color: rgba(255,255,255,0.15); color: white;">{pkg.country} · {pkg.state}</span>
                  <span class="badge badge-yellow">{pkg.days} Days</span>
                </div>
                <div>
                  {pkg.detailHref ? (
                    <a href={pkg.detailHref} class="hover:underline">
                      <h3 class="text-base font-black text-white leading-tight" style="">{pkg.name}</h3>
                    </a>
                  ) : (
                    <h3 class="text-base font-black text-white leading-tight" style="">{pkg.name}</h3>
                  )}
                  <p class="text-white/60 text-xs mt-1" style="">{pkg.cities.join(" · ")}</p>
                </div>
              </div>
            </div>

            <!-- Card body -->
            <div class="p-5 flex flex-col flex-1">
              <!-- Stats -->
              <div class="flex items-center justify-between mb-4 pb-4 border-b border-gray-100">
                <div class="text-xs text-gray-400" style="">
                  Group: <strong class="text-gray-700">{pkg.size}</strong>
                </div>
                <div class="text-xs text-gray-400" style="">
                  From <strong class="text-[#1A2744] text-sm">{pkg.price}/pax/day</strong>
                </div>
              </div>

              <!-- Highlights -->
              <div class="space-y-1.5 mb-5 flex-1">
                {pkg.highlights.slice(0, 4).map((h) => (
                  <div class="flex items-center gap-2 text-xs text-gray-500" style="">
                    <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background: #FDEA01;"></span>
                    {h}
                  </div>
                ))}
                {pkg.highlights.length > 4 && (
                  <div class="text-xs text-gray-400" style="">
                    + {pkg.highlights.length - 4} more highlights
                  </div>
                )}
              </div>

              <!-- Vehicle badge -->
              <div class="flex items-center gap-2 mb-5 py-2.5 px-3 rounded-xl" style="background-color: #F9F7F2;">
                {(() => { const VehicleIcon = vehicleIconComponents[pkg.iconKey]; return <VehicleIcon size={16} color="#1A2744" class="shrink-0" />; })()}
                <span class="text-xs font-semibold text-gray-600" style="">{pkg.vehicle}</span>
              </div>

              <!-- CTA -->
              <div class="flex flex-col gap-2">
                {pkg.detailHref && (
                  <a
                    href={pkg.detailHref}
                    class="btn-outline-navy w-full justify-center"
                    style="padding: 0.625rem 1.5rem; font-size: 0.75rem;"
                  >
                    View Full Itinerary
                  </a>
                )}
                <a
                  href={`/packages/request?package=${pkg.id}&name=${encodeURIComponent(pkg.name)}`}
                  class="btn-secondary w-full justify-center"
                  style="padding: 0.625rem 1.5rem; font-size: 0.75rem;"
                >
                  Request This Package
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Empty state -->
      <div id="no-packages-msg" class="text-center py-16" style="display: none;">
        <p class="text-gray-500 text-sm mb-2">No packages published for this location yet.</p>
        <p class="text-gray-400 text-xs">More state and provincial packages are coming soon — tell us the cities and we'll build a custom itinerary.</p>
      </div>
    </div>
  </section>

  <!-- Custom CTA -->
  <section class="py-20 diagonal-lines" style="background-color: #1A2744;">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-6" style="background-color: #FDEA01;">
          <Plus size={28} color="#1A2744" stroke-width={2.5} />
        </div>
        <h2 class="text-3xl font-black text-white mb-4" style="">
          Have a Custom Route?<br />
          <span style="color: #FDEA01;">We'll Build It.</span>
        </h2>
        <p class="text-white/60 mb-8 leading-relaxed" style="">
          Don't see exactly what your client needs? Tell us the cities, the dates, and the group size — our operations team will design a bespoke transportation itinerary within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn-primary">Request Custom Itinerary</a>
          <a href="/network" class="btn-outline-white">View Our Coverage</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    let currentCountry: string | null = null;
    let currentState = "ALL";

    function setActiveTopBtn(activeId: string) {
      const ids = ["btn-all", "btn-usa", "btn-canada"];
      ids.forEach((id) => {
        const btn = document.getElementById(id);
        if (!btn) return;
        if (id === activeId) {
          btn.style.backgroundColor = "#1A2744";
          btn.style.color = "white";
          btn.style.borderColor = "#1A2744";
        } else {
          btn.style.backgroundColor = "transparent";
          btn.style.color = "#1A2744";
          btn.style.borderColor = "#E5E7EB";
        }
      });
    }

    function setActiveStateBtn(country: string, state: string) {
      document.querySelectorAll<HTMLButtonElement>(".state-btn").forEach((btn) => {
        const isActive = btn.dataset.country === country && btn.dataset.state === state;
        if (isActive) {
          btn.style.backgroundColor = "#FDEA01";
          btn.style.color = "#1A2744";
          btn.style.borderColor = "#FDEA01";
        } else {
          btn.style.backgroundColor = "transparent";
          btn.style.color = "#1A2744";
          btn.style.borderColor = "#E5E7EB";
        }
      });
    }

    function applyFilter() {
      const cards = document.querySelectorAll<HTMLElement>(".package-card");
      let visibleCount = 0;
      cards.forEach((card) => {
        const matchesCountry = !currentCountry || card.dataset.country === currentCountry;
        const matchesState = currentState === "ALL" || card.dataset.state === currentState;
        const visible = matchesCountry && matchesState;
        card.style.display = visible ? "" : "none";
        if (visible) visibleCount++;
      });
      const emptyMsg = document.getElementById("no-packages-msg");
      if (emptyMsg) emptyMsg.style.display = visibleCount === 0 ? "" : "none";
    }

    function showAll() {
      currentCountry = null;
      currentState = "ALL";
      const usaBar = document.getElementById("state-bar-USA");
      const caBar = document.getElementById("state-bar-Canada");
      if (usaBar) usaBar.style.display = "none";
      if (caBar) caBar.style.display = "none";
      setActiveTopBtn("btn-all");
      applyFilter();
    }

    function showCountry(country: "USA" | "Canada") {
      currentCountry = country;
      currentState = "ALL";
      const usaBar = document.getElementById("state-bar-USA");
      const caBar = document.getElementById("state-bar-Canada");
      if (usaBar) usaBar.style.display = country === "USA" ? "" : "none";
      if (caBar) caBar.style.display = country === "Canada" ? "" : "none";
      setActiveTopBtn(country === "USA" ? "btn-usa" : "btn-canada");
      setActiveStateBtn(country, "ALL");
      applyFilter();
    }

    function filterState(country: string, state: string) {
      currentCountry = country;
      currentState = state;
      setActiveStateBtn(country, state);
      applyFilter();
    }

    (window as any).showAll = showAll;
    (window as any).showCountry = showCountry;

    // With the site's <ClientRouter /> (View Transitions) enabled, script tags only
    // execute once per browser session — navigating away and back to this page would
    // otherwise leave the state buttons with no click listeners wired up (or wired to
    // elements that no longer exist). Re-run this setup on every navigation
    // (including the first) via astro:page-load.
    function initOnPageNav() {
      document.querySelectorAll<HTMLButtonElement>(".state-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const country = btn.dataset.country;
          const state = btn.dataset.state;
          if (country && state) filterState(country, state);
        });
      });

      showAll();
    }

    document.addEventListener("astro:page-load", initOnPageNav);
  </script>

</BaseLayout>
