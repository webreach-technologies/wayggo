---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import TourBusBookingForm from "../../components/react/TourBusBookingForm";
import { Zap } from "@lucide/astro";
---

<BaseLayout
  title="Request a Tour Bus — WAYGGO Ground Transportation"
  description="Request one of WAYGGO's ready-to-book group tour bus itineraries. Confirm dates and group size and our operations team replies within 24 hours."
  noindex
>

  <!-- Hero -->
  <PageHero
    badge="Get a Proposal"
    heading={'Request Your<br /><span style="color: #FDEA01;">Tour Bus</span>'}
    subheading={'Confirm dates and group size below — our operations team replies within <strong class="text-white">24 hours</strong> with a detailed proposal.'}
  />

  <!-- Form + Info -->
  <section class="py-16 lg:py-20" style="background-color: #F9F7F2;">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2">
          <div class="bg-white rounded-3xl border border-gray-100 p-5 sm:p-8 lg:p-10" style="box-shadow: 0 4px 24px rgba(26,39,68,0.08);">
            <TourBusBookingForm client:only="react" />
          </div>
        </div>
        <div class="space-y-5">
          <div class="rounded-2xl p-6" style="background-color: #FDEA01;">
            <div class="flex items-center gap-3 mb-3">
              <div class="text-2xl"><Zap /></div>
              <h3 class="font-black text-base" style="color: #1A2744;">Book Instantly or Request a Quote</h3>
            </div>
            <p class="text-sm leading-relaxed" style="color: rgba(26,39,68,0.75);">
              Choose <strong>Instant Book</strong> to lock in your bus and driver now with a 20% deposit, or <strong>Request a Quote</strong> and our operations team replies within 24 hours with full pricing — no obligation either way.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-100">
            <h3 class="font-black text-sm uppercase tracking-widest mb-4" style="color: #1A2744;">What Happens Next</h3>
            <div class="space-y-3">
              {[
                { step: "1", text: "Tell us your trip basics, group details, and preferred bus size" },
                { step: "2", text: "Instant Book confirms your bus right away — Request a Quote goes to our operations team" },
                { step: "3", text: "You get a confirmation or an itemized proposal, with one invoice for the full route" },
              ].map((s) => (
                <div class="flex items-start gap-3">
                  <div class="w-6 h-6 rounded-full flex items-center justify-center shrink-0 text-xs font-black" style="background-color: #FDEA01; color: #1A2744;">{s.step}</div>
                  <p class="text-sm text-gray-500 leading-relaxed">{s.text}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
