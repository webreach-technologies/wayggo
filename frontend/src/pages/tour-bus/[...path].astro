---
import TourBusListingPage from "../../components/tour-bus/TourBusListingPage.astro";
import {
  loadTourBusCards,
  getBuckets,
  filterCards,
  bucketPageHref,
  PAGE_SIZE,
  type Bucket,
  type TourBusCard,
} from "../../lib/tourBus";

interface PageProps {
  bucket: Bucket;
  page: number;
  totalPages: number;
  pageCards: TourBusCard[];
  totalInBucket: number;
}

// Every combination of (all / country / country+state) x page number, except
// the bare "/tour-bus" (all tour bus, page 1) which src/pages/tour-bus.astro
// already serves. loadTourBusCards() throws if a slug would collide
// with a reserved route ("usa", "canada", or a plain page number).
export async function getStaticPaths() {
  const cards = await loadTourBusCards();
  const buckets = getBuckets();
  const paths: { params: { path: string }; props: PageProps }[] = [];

  for (const bucket of buckets) {
    const bucketCards = filterCards(cards, bucket);
    const totalPages = Math.max(1, Math.ceil(bucketCards.length / PAGE_SIZE));

    for (let page = 1; page <= totalPages; page++) {
      if (bucket.basePath === "" && page === 1) continue;

      const path = bucketPageHref(bucket, page).replace(/^\/tour-bus\/?/, "");
      const start = (page - 1) * PAGE_SIZE;
      paths.push({
        params: { path },
        props: {
          bucket,
          page,
          totalPages,
          pageCards: bucketCards.slice(start, start + PAGE_SIZE),
          totalInBucket: bucketCards.length,
        },
      });
    }
  }

  return paths;
}

const { bucket, page, totalPages, pageCards, totalInBucket } = Astro.props as PageProps;
---

<TourBusListingPage
  bucket={bucket}
  page={page}
  totalPages={totalPages}
  pageCards={pageCards}
  totalInBucket={totalInBucket}
/>
