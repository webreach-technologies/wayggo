---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TourBusBookingForm from "../../components/react/TourBusBookingForm";
import WhyChooseUs from "../../components/tour-bus/WhyChooseUs.astro";
import PerfectForEveryGroup from "../../components/tour-bus/PerfectForEveryGroup.astro";
import WhyGroupsLoveThis from "../../components/tour-bus/WhyGroupsLoveThis.astro";
import OurFleet from "../../components/tour-bus/OurFleet.astro";
import PremiumAmenities from "../../components/tour-bus/PremiumAmenities.astro";
import RequestSidebar from "../../components/tour-bus/RequestSidebar.astro";
import OnPageNav from "../../components/tour-bus/OnPageNav.astro";
import RelatedTours from "../../components/tour-bus/RelatedTours.astro";
import QuickQuoteModal from "../../components/tour-bus/QuickQuoteModal.astro";
import { Star, ChevronDown, Zap } from "@lucide/astro";
import { operatorCount } from "../../lib/tourBus";
import { withBase } from "../../lib/url";
// Placeholder hero image — used for any entry that doesn't set its own heroImage yet.
import defaultHeroImg from "../../assets/images/hero-bus.png";

export async function getStaticPaths() {
  const tourBusEntries = await getCollection("tourBus");
  return tourBusEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"tourBus">;
}

const { entry } = Astro.props;
const pkg = entry.data;

const heroImg = pkg.heroImage ?? defaultHeroImg;

const siteOrigin = Astro.site ?? new URL("https://wayggo.com");
const pageURL = new URL(Astro.url.pathname, siteOrigin).href;
const priceValue = Number(pkg.price.replace(/[^0-9.]/g, ""));

// Related tours are pulled from the content collection (not hand-typed per
// entry) so this stays accurate as entries are added or removed. Same-state
// matches rank first, then same-country, then anything else.
const otherEntries = await getCollection("tourBus", (e) => e.id !== entry.id);
const relatedEntries = otherEntries
  .map((e) => ({
    entry: e,
    score: e.data.state === pkg.state ? 2 : e.data.country === pkg.country ? 1 : 0,
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((r) => r.entry);

const touristTripSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: pkg.name,
  description: pkg.seoDescription,
  url: pageURL,
  touristType: "Group",
  provider: {
    "@type": "Organization",
    name: "WAYGGO",
    url: new URL("/", siteOrigin).href,
  },
  itinerary: {
    "@type": "ItemList",
    itemListElement: pkg.itinerary.map((stop, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${stop.day}: ${stop.title}`,
      item: {
        "@type": "TouristAttraction",
        name: stop.title,
        description: stop.desc,
      },
    })),
  },
  offers: {
    "@type": "Offer",
    priceCurrency: "USD",
    price: Number.isFinite(priceValue) ? priceValue : undefined,
    description: `Price ${pkg.priceUnit}`,
    availability: "https://schema.org/InStock",
    url: pageURL,
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pkg.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.a,
    },
  })),
};

const jumpLinks = [
  { href: "#overview", label: "Overview" },
  { href: "#why-choose", label: "Why Choose Us" },
  { href: "#groups", label: "Perfect For Groups" },
  { href: "#itinerary", label: "Highlights" },
  { href: "#why-groups-love", label: "Why Groups Love It" },
  { href: "#fleet", label: "Our Fleet" },
  { href: "#amenities", label: "Amenities" },
  ...(relatedEntries.length > 0 ? [{ href: "#related", label: "Related Tours" }] : []),
  { href: "#faq", label: "FAQ" },
  { href: "#testimonials", label: "Reviews" },
];
---

<BaseLayout
  title={pkg.seoTitle}
  description={pkg.seoDescription}
  canonical={pageURL}
  breadcrumbs={[{ name: "Tour Bus", path: "/tour-bus" }, { name: pkg.name, path: `/tour-bus/${entry.id}` }]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(touristTripSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="relative py-20 lg:py-24 diagonal-lines overflow-hidden" style="background-color: #1A2744;">
    <Image
      src={heroImg}
      alt={pkg.heroImageAlt}
      widths={[640, 828, 1200, 1600, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(90deg, #1A2744 0%, rgba(26,39,68,0.92) 40%, rgba(26,39,68,0.65) 100%);"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <span class="section-label-white mb-5 inline-flex">{pkg.tagline}</span>
        <h1 class="text-4xl lg:text-6xl font-black text-white mb-5">
          {pkg.heroHeadingLine1}<br />
          <span style="color: #FDEA01;">{pkg.heroHeadingLine2}</span>
        </h1>
        <p class="text-white/65 text-lg leading-relaxed max-w-2xl mb-8">
          {pkg.heroDescription}
        </p>

        <!-- Quick stats -->
        <div class="flex flex-wrap gap-3 mb-9">
          {[
            { label: `Served by ${operatorCount(entry.id)}+ Bus Operators` },
            { label: "Small to Large Groups" },
            { label: "Van" },
            { label: "Minibus" },
            { label: "Mini Coach" },
            { label: "Motor Coach" },
            { label: `Start From ${pkg.price}${pkg.priceUnit}` },
          ].map((s) => (
            <span class="px-4 py-2 rounded-full text-xs font-bold text-white" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
              {s.label}
            </span>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#request" class="btn-primary">Book Now / Request Quote</a>
          <button type="button" class="btn-outline-white" data-qqm-open>Submit Itinerary</button>
        </div>
      </div>
    </div>
  </section>

  <QuickQuoteModal tourBusLabel={pkg.name} />

  <div id="page-content">

  <!-- About the tour -->
  <section id="overview" class="py-16 lg:py-20" style="background-color: white;">
    <div class="container">
      <div class="main-content">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="section-label">Tour Overview</span>
            <h2 class="text-3xl font-black mt-4 mb-5" style="color: #1A2744;">
              {pkg.overviewHeading}
            </h2>
            <p class="text-gray-500 leading-relaxed mb-4">
              {pkg.overviewParagraphs[0]}
            </p>
            <p class="text-gray-500 leading-relaxed">
              {pkg.overviewParagraphs[1]}
            </p>
          </div>
          <div class="relative h-72 lg:h-96 rounded-3xl overflow-hidden">
            {pkg.overviewImage ? (
              <Image
                src={pkg.overviewImage}
                alt={pkg.name}
                widths={[400, 800, 1200]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover"
              />
            ) : (
              <>
                <div class="absolute inset-0" style="background: linear-gradient(135deg, #1e293b, #334155);"></div>
                <div class="absolute inset-0 diagonal-lines"></div>
              </>
            )}
            {pkg.overviewImage && <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 60%);" />}
            <div class="absolute inset-0 p-8 flex flex-col justify-end">
              <h3 class="text-2xl font-black text-white leading-tight">{pkg.name}</h3>
              <p class="text-white/60 text-sm mt-1">{pkg.cities.join(" · ")}</p>
            </div>
          </div>
        </div>

        <div class="mt-10">
          <p class="text-gray-500 leading-relaxed mb-4">
            {pkg.overviewParagraphs[2]}
          </p>
          <p class="text-gray-500 leading-relaxed">
            {pkg.overviewParagraphs[3]}
          </p>
        </div>
      </div>
    </div>
  </section>

  <WhyChooseUs />

  <PerfectForEveryGroup />

  <!-- Tour bus highlights -->
  <section id="itinerary" class="py-16 lg:py-20" style="background-color: #F9F7F2;">
    <div class="container">
      <div class="main-content">
        <div class="text-center mb-10 max-w-2xl mx-auto">
          <span class="section-label">What Makes This Perfect</span>
          <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Attractions Highlights</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
          {pkg.tourHighlights.map((h) => (
            <div class="flex items-center gap-3 rounded-xl p-4 bg-white">
              <Star size={18} color="#FDEA01" fill="#FDEA01" stroke-width={1} class="shrink-0" />
              <span class="text-sm font-semibold" style="color: #1A2744;">{h}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <WhyGroupsLoveThis tourName={pkg.name} thingsToDo={pkg.thingsToDo} />

  <OurFleet />

  <PremiumAmenities />

  <!-- CTA -->
  <section class="py-20 diagonal-lines" style="background-color: #1A2744;">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-6" style="background-color: #FDEA01;">
          <Zap size={28} color="#1A2744" stroke-width={2.5} />
        </div>
        <h2 class="text-3xl font-black text-white mb-4">
          Ready for Your<br />
          <span style="color: #FDEA01;">{pkg.name} Adventure?</span>
        </h2>
        <p class="text-white/60 mb-8 leading-relaxed">
          Confirm your dates and group size and our operations team will send a detailed proposal within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#request" class="btn-primary">Request This Tour Bus</a>
          <a href={withBase("/tour-bus")} class="btn-outline-white">View All Tour Bus</a>
        </div>
      </div>
    </div>
  </section>

  <OnPageNav jumpLinks={jumpLinks} />

  <RelatedTours related={relatedEntries} />

  <!-- FAQ -->
  <section id="faq" class="py-16 lg:py-20" style="background-color: white;">
    <div class="container max-w-3xl">
      <div class="main-content">
        <div class="text-center mb-12">
          <span class="section-label">Common Questions</span>
          <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {pkg.faqs.map((faq) => (
            <details class="rounded-2xl border border-gray-100 group" style="background: #F9F7F2;">
              <summary class="flex items-center justify-between px-6 py-5 cursor-pointer select-none">
                <span class="font-semibold text-sm pr-4" style="color: #1A2744;">{faq.q}</span>
                <ChevronDown size={20} class="shrink-0 transition-transform group-open:rotate-180" style="color: #6B7280;" />
              </summary>
              <div class="px-6 pb-5">
                <p class="text-sm text-gray-500 leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What our customers say -->
  <section id="testimonials" class="py-16 lg:py-20" style="background-color: #F9F7F2;">
    <div class="container">
      <div class="main-content">
        <div class="text-center mb-12">
          <span class="section-label">Client Feedback</span>
          <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Why They Love WAYGGO</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {pkg.testimonials.map((t) => (
            <div class="rounded-2xl p-8 bg-white" style="box-shadow: 0 2px 16px rgba(26,39,68,0.06);">
              <div class="flex gap-0.5 mb-5">
                {[1,2,3,4,5].map(() => (
                  <Star size={14} fill="#FDEA01" stroke="none" />
                ))}
              </div>
              <blockquote class="text-sm leading-relaxed text-gray-600 mb-6 italic">
                "{t.quote}"
              </blockquote>
              <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
                <div class="w-10 h-10 rounded-full flex items-center justify-center text-base font-black" style="background: #1A2744; color: #FDEA01;">
                  {t.name.charAt(0)}
                </div>
                <div>
                  <p class="text-sm font-bold" style="color: #1A2744;">{t.name}</p>
                  <p class="text-xs text-gray-400">{t.role} · {t.company}</p>
                </div>
                <div class="ml-auto text-xl">{t.flag}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  </div>

  <!-- Request quote — placed last, right before the footer -->
  <section id="request" class="py-16 lg:py-20" style="background-color: #F9F7F2;">
    <div class="container">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="section-label">Get a Proposal</span>
        <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Request the {pkg.name} Tour Bus</h2>
        <p class="text-gray-500 mt-3">Confirm dates and group size below — our operations team replies within 24 hours with a detailed proposal.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2">
          <div class="bg-white rounded-3xl border border-gray-100 p-5 sm:p-8 lg:p-10" style="box-shadow: 0 4px 24px rgba(26,39,68,0.08);">
            <TourBusBookingForm client:load tourBusLabel={pkg.tourBusLabel} />
          </div>
        </div>
        <RequestSidebar />
      </div>
    </div>
  </section>

</BaseLayout>
