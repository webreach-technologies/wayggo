<BaseLayout
  title="Terms of Service — WAYGGO Charters"
  description="The terms that apply to using the WAYGGO Charters website and group transportation coordination services across the United States and Canada."
  breadcrumbs={[{ name: "Terms of Service", path: "/terms-of-service" }]}
