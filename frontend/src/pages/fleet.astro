---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import FleetFilterBar from "../components/sections/FleetFilterBar.astro";
import FleetVehicleRow from "../components/sections/FleetVehicleRow.astro";
import PartnerCTA from "../components/sections/PartnerCTA.astro";
import luxuryvanImg from "../assets/fleet/luxuryvan.png";
import minibusImg from "../assets/fleet/minibus.png";
import fullsizebusImg from "../assets/fleet/fullsizebus.png";
import motorcoachImg from "../assets/fleet/motorcoach.png";

const vehicles = [
  {
    id: "van",
    iconKey: "van",
    image: luxuryvanImg,
    name: "Van",
    tagline: "Premium small-group travel",
    capacity: { passengers: "6–14", luggage: "8–12 bags" },
    features: [
      { iconKey: "wifi",       label: "WiFi & Mobile Charging" },
      { iconKey: "snowflake",  label: "Dual-zone Climate Control" },
      { iconKey: "armchair",   label: "Captain's Leather Seats" },
      { iconKey: "volume",     label: "Premium Sound System" },
      { iconKey: "suitcase",   label: "Ample Luggage Space" },
      { iconKey: "windowgrid", label: "Privacy Tinted Windows" },
    ],
    idealFor: ["Airport VIP Transfers", "Small Group City Tours", "Executive Group Travel", "Wedding Party Shuttles", "Intimate Private Tours"],
    color: "#1A2744",
  },
  {
    id: "minibus",
    iconKey: "bus",
    image: minibusImg,
    name: "Minibus",
    tagline: "The workhorse of city touring",
    capacity: { passengers: "15–28", luggage: "18–24 bags" },
    features: [
      { iconKey: "megaphone",  label: "PA Microphone System" },
      { iconKey: "snowflake",  label: "Full Cabin Air Conditioning" },
      { iconKey: "windowgrid", label: "Panoramic View Windows" },
      { iconKey: "lightbulb",  label: "Individual Reading Lights" },
      { iconKey: "wifi",       label: "WiFi Available" },
      { iconKey: "suitcase",   label: "Underbelly Luggage Hold" },
    ],
    idealFor: ["City Sightseeing Tours", "Airport Group Transfers", "Day Trip Excursions", "University Campus Visits", "Cultural Group Outings"],
    color: "#243460",
  },
  {
    id: "mini-coach",
    iconKey: "fullbus",
    image: motorcoachImg,
    name: "Mini Coach",
    tagline: "Airport-ready, flexible for hotel-hop routing",
    capacity: { passengers: "29–35", luggage: "28–34 bags" },
    features: [
      { iconKey: "plane",    label: "Airport-Ready Configuration" },
      { iconKey: "building", label: "Hotel Door-to-Door" },
      { iconKey: "suitcase", label: "Overhead & Rear Luggage" },
      { iconKey: "snowflake",label: "Climate Controlled" },
      { iconKey: "zap",      label: "USB Charging" },
      { iconKey: "mappin",   label: "Flexible Route Stops" },
    ],
    idealFor: ["Airport–Hotel Transfers", "Convention Center Shuttles", "Cruise Terminal Connections", "Hotel Loop Shuttles", "Small Event Transport"],
    color: "#0D1B3E",
  },
  {
    id: "motor-coach",
    iconKey: "motorcoach",
    image: fullsizebusImg,
    name: "Motor Coach",
    tagline: "Full luxury for large groups",
    capacity: { passengers: "36–56", luggage: "40–56 bags" },
    features: [
      { iconKey: "armchair",  label: "Premium Reclining Seats" },
      { iconKey: "monitor",   label: "Multiple HD Monitors" },
      { iconKey: "megaphone", label: "Professional PA System" },
      { iconKey: "droplet",   label: "Full Onboard Restroom" },
      { iconKey: "wifi",      label: "High-Speed WiFi" },
      { iconKey: "snowflake", label: "Climate Control Throughout" },
    ],
    idealFor: ["Long-Distance Interstate Tours", "Large Group Sightseeing", "Multi-City Grand Tours", "Sports Fan Charters", "Convention & Conference Groups"],
    color: "#1A2744",
  },
];
---

<BaseLayout
  title="Fleet & Capabilities — WAYGGO Charters Ground Transportation"
  description="From 6-passenger luxury vans to 56-seat motorcoaches. Explore WAYGGO Charters' complete ground transportation fleet for international tour operators across North America."
  breadcrumbs={[{ name: "Fleet", path: "/fleet" }]}
>

  <!-- Hero -->
  <PageHero
    badge="Fleet & Capabilities"
    heading={'The Right Vehicle<br /><span style="color: #FDEA01;">For Every Group</span>'}
    subheading="6 passengers or 56. Airport transfer or 12-day cross-country tour. WAYGGO Charters sources the exact vehicle your itinerary demands — all meticulously maintained, fully insured, and operated by vetted professionals."
  />

  <FleetFilterBar vehicles={vehicles} />

  <!-- Vehicle Sections -->
  {vehicles.map((v, i) => (
    <FleetVehicleRow
      id={v.id}
      index={i}
      image={v.image}
      color={v.color}
      iconKey={v.iconKey}
      name={v.name}
      tagline={v.tagline}
      capacity={v.capacity}
      features={v.features}
      idealFor={v.idealFor}
    />
  ))}

  <PartnerCTA
    badge="Custom Configurations"
    heading="Can't Find"
    headingHighlight="the Right Fit?"
    subheading="Large delegations, back-to-back multi-city legs, mixed fleet for different group sizes — we build custom configurations for complex itineraries every day."
    primaryCta={{ label: "Discuss Custom Requirements", href: "/contact" }}
    secondaryCta={{ label: "Browse Tour Bus", href: "/tour-bus" }}
  />

</BaseLayout>
