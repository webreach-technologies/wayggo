---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PackageBookingForm from "../../components/react/PackageBookingForm";
import PackageGallery from "../../components/react/PackageGallery";
import {
  Bus, ShieldCheck, Wifi, Clock, MapPin, Headphones,
  Usb, Armchair, Snowflake, Volume2,
  Star, ChevronDown, ArrowRight, Zap,
  House, CircleParking, Users, Camera,
} from "@lucide/astro";
import luxuryvanImg from "../../assets/fleet/luxuryvan.png";
import minibusImg from "../../assets/fleet/minibus.png";
import chartershuttleImg from "../../assets/fleet/chartershuttle.png";
import fullsizebusImg from "../../assets/fleet/fullsizebus.png";
// Placeholder hero image — swap this import for an actual New York City photo when ready.
import heroImg from "../../assets/images/hero-bus.png";

const pkg = {
  id: "nyc-icons",
  groupPackageLabel: "New York City Icons",
  name: "New York City Icons",
  tagline: "5-Day Small Group NYC Landmarks Package",
  days: 5,
  size: "8–20 passengers",
  vehicle: "Luxury Van or Minibus",
  price: "$180",
  priceUnit: "/pax/day",
  cities: ["New York City"],
};

const whyChooseBus = [
  { icon: Bus, title: "Modern Charter Fleet", desc: "Clean, late-model vans and minibuses maintained to a strict inspection schedule." },
  { icon: ShieldCheck, title: "Licensed, Vetted Drivers", desc: "NYC-experienced drivers, background-checked and fully licensed for city driving." },
  { icon: Wifi, title: "Free WiFi Onboard", desc: "Stay connected between stops with complimentary WiFi on every vehicle." },
  { icon: Clock, title: "On-Time Guarantee", desc: "Built-in buffer time for Manhattan traffic keeps your itinerary on schedule." },
  { icon: MapPin, title: "Local Route Expertise", desc: "Drivers who know which entrances, drop-offs, and shortcuts save your group time." },
  { icon: Headphones, title: "24/7 Support Line", desc: "A real person answers if plans change mid-tour — any day, any hour." },
];

const groupGalleryTypes = [
  { label: "Family & Multigenerational Groups", sub: "Easy pacing, stroller & wheelchair friendly", gradient: "linear-gradient(135deg, #b91c1c, #7c2d12)" },
  { label: "School & Educational Trips", sub: "Curriculum-aligned museum & landmark stops", gradient: "linear-gradient(135deg, #1d4ed8, #1e3a8a)" },
  { label: "Corporate & MICE Groups", sub: "Roadshows, incentive trips, conference shuttles", gradient: "linear-gradient(135deg, #334155, #1e293b)" },
  { label: "Weddings & Celebrations", sub: "Guest shuttles, bachelor/ette party routes", gradient: "linear-gradient(135deg, #9d174d, #831843)" },
  { label: "Sports & Fan Groups", sub: "Stadium transfers, game-day charters", gradient: "linear-gradient(135deg, #065f46, #064e3b)" },
  { label: "Senior & Leisure Clubs", sub: "Comfortable seating, accessible boarding", gradient: "linear-gradient(135deg, #7c3aed, #5b21b6)" },
  { label: "Friends' Getaways & Reunions", sub: "Flexible multi-stop nightlife routing", gradient: "linear-gradient(135deg, #b45309, #92400e)" },
  { label: "Sightseeing & City Tour Groups", sub: "Landmark-hopping with flexible photo stops", gradient: "linear-gradient(135deg, #0e7490, #155e75)" },
  { label: "Religious & Pilgrimage Groups", sub: "Sacred sites handled with care and punctuality", gradient: "linear-gradient(135deg, #92400e, #78350f)" },
];

const packageHighlights = [
  "Times Square & Broadway Theater District",
  "Statue of Liberty & Ellis Island Cruise",
  "Central Park Guided Tour",
  "9/11 Memorial & Museum",
  "Empire State Building Observatory",
  "Brooklyn Bridge Walk",
  "Fifth Avenue Shopping District",
  "Rockefeller Center & Top of the Rock",
];

const itinerary = [
  { day: "Day 1", title: "Arrival & Manhattan Skyline", desc: "Airport pickup, hotel check-in, and an evening orientation drive past Times Square and Midtown." },
  { day: "Day 2", title: "Downtown & 9/11 Memorial", desc: "9/11 Memorial & Museum, Wall Street, Brooklyn Bridge walk, and a South Street Seaport stop." },
  { day: "Day 3", title: "Central Park & Uptown", desc: "Guided Central Park tour, Museum Mile, and Fifth Avenue shopping in the afternoon." },
  { day: "Day 4", title: "Statue of Liberty & Brooklyn", desc: "Morning Liberty & Ellis Island cruise, afternoon in DUMBO and Brooklyn Heights." },
  { day: "Day 5", title: "Rockefeller Center & Departure", desc: "Top of the Rock observation deck, last-minute shopping, then airport or hotel drop-off." },
];

const whyGroupsLoveThis = [
  { icon: House, label: "Door-to-Door Pickups & Drop-offs" },
  { icon: CircleParking, label: "Zero Parking Hassles" },
  { icon: Users, label: "Kid & Senior Friendly" },
  { icon: MapPin, label: "Flexible Multi-Stop Routing" },
  { icon: Camera, label: "Photo-Ready Landmark Stops" },
];

const fleetForThisPackage = [
  { name: "Luxury Van", capacity: "6–14 pax", desc: "Premium leather seating for small VIP groups.", image: luxuryvanImg },
  { name: "Minibus", capacity: "15–28 pax", desc: "Panoramic windows, ideal for mid-size groups.", image: minibusImg },
  { name: "Charter Shuttle", capacity: "8–16 pax", desc: "Airport-ready, flexible for hotel-hop routing.", image: chartershuttleImg },
  { name: "Full-Size Bus", capacity: "29–40 pax", desc: "For larger delegations touring together.", image: fullsizebusImg },
];

const premiumAmenities = [
  { icon: Wifi, label: "Free WiFi" },
  { icon: Usb, label: "USB Charging" },
  { icon: Armchair, label: "Reclining Seats" },
  { icon: Snowflake, label: "Climate Control" },
  { icon: Volume2, label: "PA System & Mic" },
];

const relatedPackages = [
  { name: "East Coast Grand Tour", days: 10, size: "21–56 pax", price: "$145/pax/day", gradient: "linear-gradient(135deg, #0D1B3E, #243460)", cities: ["New York City", "Philadelphia", "Washington D.C.", "Baltimore"] },
  { name: "Boston & New England Discovery", days: 4, size: "8–20 pax", price: "$175/pax/day", gradient: "linear-gradient(135deg, #7f1d1d, #9f1239)", cities: ["Boston", "Salem", "Cape Cod"] },
  { name: "Washington DC & Colonial Heritage", days: 4, size: "8–20 pax", price: "$160/pax/day", gradient: "linear-gradient(135deg, #1e3a8a, #312e81)", cities: ["Washington D.C.", "Colonial Williamsburg"] },
];

const faqs = [
  { q: "What's the minimum and maximum group size for this package?", a: "8–20 passengers in a Luxury Van or Minibus. For larger delegations, ask about our Full-Size Bus or East Coast Grand Tour options." },
  { q: "Does this package include a tour guide?", a: "The price includes a professional driver. An English or multilingual guide can be added for an additional daily rate — let us know in your request." },
  { q: "Are hotel stays or attraction tickets included?", a: "No — this is a ground transportation package. Attraction admission (Liberty cruise, museums, observatories) is booked separately or through your local guide." },
  { q: "Can we customize the itinerary or swap a day?", a: "Yes. Every package is a starting template. Tell us your changes in the request form below and we'll send back a revised proposal." },
  { q: "How does parking and drop-off work in Manhattan?", a: "Our drivers know the city's loading zones and attraction entrances, so your group is dropped as close as legally possible without circling for parking." },
  { q: "How far in advance should we confirm?", a: "3–4 weeks minimum; 6+ weeks during the Jun–Aug summer peak and the Nov–Jan holiday season, when vehicles book up fastest." },
  { q: "What happens if the schedule needs to change mid-tour?", a: "Call our 24/7 support line — we'll adjust pickup times or swap stops on the fly with no extra paperwork." },
];

const testimonials = [
  {
    quote: "Five days, twelve stops, and not a single missed pickup. Our clients specifically ask for the NYC Icons route now.",
    name: "Laura Bennett",
    role: "Group Travel Manager",
    company: "Meridian Tours",
    flag: "🇨🇦",
  },
  {
    quote: "The driver knew exactly where to stage for Top of the Rock and the Liberty ferry — saved us close to an hour each day.",
    name: "Marco Ferretti",
    role: "Tour Director",
    company: "Bella Italia Viaggi",
    flag: "🇮🇹",
  },
];

const jumpLinks = [
  { href: "#overview", label: "Overview" },
  { href: "#why-choose", label: "Why Choose Us" },
  { href: "#groups", label: "Perfect For Groups" },
  { href: "#itinerary", label: "Itinerary" },
  { href: "#why-groups-love", label: "Why Groups Love It" },
  { href: "#fleet", label: "Our Fleet" },
  { href: "#amenities", label: "Amenities" },
  { href: "#related", label: "Related Tours" },
  { href: "#faq", label: "FAQ" },
  { href: "#testimonials", label: "Reviews" },
];
---

<BaseLayout
  title="New York City Icons — 5-Day Package — WAYGGO"
  description="A 5-day, small-group ground transportation package covering New York City's essential landmarks — Times Square, the Statue of Liberty, Central Park, 9/11 Memorial, and Brooklyn."
>

  <!-- Hero (same treatment as the Niagara Falls & Toronto Explorer package, plus a full-bleed background image) -->
  <section class="relative py-20 lg:py-24 diagonal-lines overflow-hidden" style="background-color: #1A2744;">
    <!-- Placeholder hero background image — swap heroImg's import above for an actual New York City photo when ready. -->
    <Image
      src={heroImg}
      alt="New York City Icons package"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(90deg, #1A2744 0%, rgba(26,39,68,0.92) 40%, rgba(26,39,68,0.65) 100%);"></div>
    <div class="container relative">
      <div class="max-w-3xl">
        <span class="section-label-white mb-5 inline-flex">{pkg.tagline}</span>
        <h1 class="text-4xl lg:text-6xl font-black text-white mb-5">
          New York City<br />
          <span style="color: #FDEA01;">Icons</span>
        </h1>
        <p class="text-white/65 text-lg leading-relaxed max-w-2xl mb-8">
          Every must-see landmark in one van, one driver, and one itinerary. WAYGGO handles the traffic, the parking, and the pickups — your travelers just show up and see the city.
        </p>

        <!-- Quick stats -->
        <div class="flex flex-wrap gap-3 mb-9">
          {[
            { label: `${pkg.days} Days / ${pkg.days - 1} Nights` },
            { label: pkg.size },
            { label: pkg.vehicle },
            { label: `From ${pkg.price}${pkg.priceUnit}` },
          ].map((s) => (
            <span class="px-4 py-2 rounded-full text-xs font-bold text-white" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);">
              {s.label}
            </span>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#request" class="btn-primary">Request This Package</a>
          <a href="#itinerary" class="btn-outline-white">View Full Itinerary</a>
        </div>
      </div>
    </div>
  </section>

  <div id="page-content">

  <!-- About the tour -->
  <section id="overview" class="py-16 lg:py-20" style="background-color: white;">
    <div class="container">
      <div class="main-content">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="section-label">Tour Overview</span>
            <h2 class="text-3xl font-black mt-4 mb-5" style="color: #1A2744;">
              One Van, Every NYC Icon
            </h2>
            <p class="text-gray-500 leading-relaxed mb-4">
              This package moves your group through Manhattan and Brooklyn's essential landmarks over five days — without a single subway transfer or taxi line. From Times Square to the Statue of Liberty, Central Park to Top of the Rock, your driver handles the route, the traffic, and the drop-offs.
            </p>
            <p class="text-gray-500 leading-relaxed">
              Built for international tour operators booking small groups of 8–20 travelers, the package includes the vehicle, a professional driver, and daily hotel pickups — so you can quote one line item and let WAYGGO run the city.
            </p>
          </div>
          <div class="relative h-72 lg:h-96 rounded-3xl overflow-hidden">
            <div class="absolute inset-0" style="background: linear-gradient(135deg, #1e293b, #334155);"></div>
            <div class="absolute inset-0 diagonal-lines"></div>
            <div class="absolute inset-0 p-8 flex flex-col justify-end">
              <h3 class="text-2xl font-black text-white leading-tight">Manhattan Skyline</h3>
              <p class="text-white/60 text-sm mt-1">Times Square to the Empire State Building</p>
            </div>
          </div>
        </div>

        <div class="mt-10">
          <p class="text-gray-500 leading-relaxed mb-4">
            Whether you're running a single group or coordinating multiple departures across the week, WAYGGO scales the vehicle to match — from an intimate 6-passenger Luxury Van to a 40-passenger Full-Size Bus for larger delegations. Every itinerary starts from this five-day template, but timing, stops, and pacing are yours to adjust before we confirm.
          </p>
          <p class="text-gray-500 leading-relaxed">
            Your driver stays with the group for the full five days, learning your travelers' pace after day one and adjusting drop-off points, waiting spots, and walking distances accordingly. No new driver to brief, no repeated instructions — just one point of contact who already knows the plan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why choose our NYC bus -->
  <section id="why-choose" class="py-16 lg:py-20" style="background-color: #F9F7F2;">
    <div class="container">
      <div class="main-content">
        <div class="text-center mb-12 max-w-2xl mx-auto">
          <span class="section-label">Why Ride With Us</span>
          <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Why Choose Our New York City Bus</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {whyChooseBus.map((item) => (
            <div class="flex gap-4 bg-white rounded-2xl p-6" style="box-shadow: 0 2px 16px rgba(26,39,68,0.06);">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center shrink-0 bg-yellow">
                <item.icon size={20} color="#1A2744" />
              </div>
              <div>
                <h4 class="font-black text-sm mb-1" style="color: #1A2744;">{item.title}</h4>
                <p class="text-xs text-gray-500 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Perfect for every group — reuses the same lightbox gallery component as the Niagara package's photo gallery -->
  <section id="groups" class="py-16 lg:py-20" style="background-color: white;">
    <div class="container">
      <div class="main-content">
        <div class="text-center mb-10 max-w-2xl mx-auto">
          <span class="section-label">Flexible By Design</span>
          <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Perfect for Every Group</h2>
          <p class="text-gray-500 mt-3">The same route, tuned to how your group actually travels.</p>
        </div>
        <PackageGallery client:load images={groupGalleryTypes} layout="grid" />
      </div>
    </div>
  </section>

  <!-- Package highlights + itinerary, side by side -->
  <section id="itinerary" class="py-16 lg:py-20" style="background-color: #F9F7F2;">
    <div class="container">
      <div class="main-content">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <div>
            <span class="section-label">What Makes This Route</span>
            <h2 class="text-3xl font-black mt-4 mb-8" style="color: #1A2744;">Package Highlights</h2>
            <div class="grid grid-cols-1 gap-3">
              {packageHighlights.map((h) => (
                <div class="flex items-center gap-3 rounded-xl p-4 bg-white">
                  <Star size={18} color="#FDEA01" fill="#FDEA01" stroke-width={1} class="shrink-0" />
                  <span class="text-sm font-semibold" style="color: #1A2744;">{h}</span>
                </div>
              ))}
            </div>
          </div>

          <div>
            <span class="section-label">Day-by-Day</span>
            <h2 class="text-3xl font-black mt-4 mb-8" style="color: #1A2744;">Itinerary</h2>
            <div class="relative">
              <div class="absolute left-4.5 top-2 bottom-2 w-px" style="background-color: #E5E7EB;"></div>
              <div class="space-y-5">
                {itinerary.map((stop, i) => (
                  <div class="relative flex gap-4">
                    <div class="relative z-10 w-9 h-9 rounded-full flex items-center justify-center text-xs font-black shrink-0" style="background-color: #1A2744; color: #FDEA01;">
                      {i + 1}
                    </div>
                    <div class="flex-1 rounded-2xl p-5 bg-white">
                      <span class="badge badge-navy mb-2">{stop.day}</span>
                      <h4 class="font-black text-base mb-1" style="color: #1A2744;">{stop.title}</h4>
                      <p class="text-sm text-gray-500 leading-relaxed">{stop.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why groups love this tour -->
  <section id="why-groups-love" class="py-16 lg:py-20" style="background-color: white;">
    <div class="container">
      <div class="main-content">
        <div class="text-center mb-12">
          <span class="section-label">Traveler Favorites</span>
          <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Why Group Love To Frquntly Visit This Place</h2>
        </div>
        <div class="flex flex-wrap justify-center gap-x-10 gap-y-8">
          {whyGroupsLoveThis.map((item) => (
            <div class="flex flex-col items-center text-center w-32">
              <div class="w-16 h-16 rounded-full flex items-center justify-center mb-3" style="background-color: #1A2744;">
                <item.icon size={24} color="#FDEA01" stroke-width={2} />
              </div>
              <span class="text-xs font-bold leading-snug" style="color: #1A2744;">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Our fleet -->
  <section id="fleet" class="py-16 lg:py-20" style="background-color: #F9F7F2;">
    <div class="container">
      <div class="main-content">
        <div class="text-center mb-12 max-w-2xl mx-auto">
          <span class="section-label">Vehicle Options</span>
          <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Our Fleet for This Route</h2>
          <p class="text-gray-500 mt-3">Every vehicle option scales to your group size — swap anytime before confirming.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {fleetForThisPackage.map((v) => (
            <div class="rounded-2xl overflow-hidden bg-white card-hover" style="box-shadow: 0 4px 24px rgba(26,39,68,0.08);">
              <div class="h-32 relative overflow-hidden" style="background: linear-gradient(135deg, #1A2744, #243460);">
                <Image src={v.image} alt={v.name} quality={1} class="absolute inset-0 w-full h-full object-contain" style="padding: 0.75rem;" />
              </div>
              <div class="p-5">
                <h3 class="font-black text-sm mb-1" style="color: #1A2744;">{v.name}</h3>
                <p class="text-xs font-bold mb-2" style="color: #E6BB00;">{v.capacity}</p>
                <p class="text-xs text-gray-500 leading-relaxed">{v.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Premium amenities -->
  <section id="amenities" class="py-16 lg:py-20" style="background-color: white;">
    <div class="container">
      <div class="main-content">
        <div class="text-center mb-12">
          <span class="section-label">Onboard Comfort</span>
          <h2 class="text-3xl lg:text-4xl font-black mt-4" style="color: #1A2744;">Premium Amenities</h2>
        </div>
        <div class="flex flex-wrap justify-center gap-6">
          {premiumAmenities.map((a) => (
            <div class="flex flex-col items-center text-center w-28 rounded-2xl py-6 px-3" style="background-color: #F9F7F2;">
              <div class="w-12 h-12 rounded-full flex items-center justify-center mb-3 bg-yellow">
                <a.icon size={20} color="#1A2744" stroke-width={2} />
              </div>
              <span class="text-xs font-bold leading-snug" style="color: #1A2744;">{a.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 diagonal-lines" style="background-color: #1A2744;">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-6" style="background-color: #FDEA01;">
          <Zap size={28} color="#1A2744" stroke-width={2.5} />
        </div>
        <h2 class="text-3xl font-black text-white mb-4">
          Ready for Your<br />
          <span style="color: #FDEA01;">New York City Adventure?</span>
        </h2>
        <p class="text-white/60 mb-8 leading-relaxed">
          Confirm your dates and group size and our operations team will send a detailed proposal within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#request" class="btn-primary">Request This Package</a>
          <a href="/packages" class="btn-outline-white">View All Packages</a>
        </div>
      </div>
    </div>
  </section>

  <!-- On-page nav: fixed to the right edge of the viewport (only on screens with room to spare) -->
  <div class="hidden xl:block on-page-nav" style="position: fixed; top: 96px; right: 2rem; width: 200px; max-height: calc(100vh - 120px);">
    <div class="rounded-xl border border-gray-100 p-4 flex flex-col" style="box-shadow: 0 4px 24px rgba(26,39,68,0.08); background-color: white; max-height: calc(100vh - 120px);">
      <h3 class="text-[0.65rem] uppercase font-black tracking-widest mb-2 px-1 shrink-0" style="color: #1A2744;">On This Page</h3>
      <nav class="flex flex-col mb-3 overflow-y-auto">
        {jumpLinks.map((link) => (
          <a
            href={link.href}
            data-jump-link
            data-target={link.href.replace("#", "")}
            class="jump-link px-2 py-1.5 rounded-md text-xs font-semibold transition-colors"
            style="color: #1A2744;"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <a
        href="#request"
        class="shrink-0 inline-flex items-center justify-center w-full rounded-full font-black uppercase tracking-widest text-white transition-all whitespace-nowrap"
        style="background-color: #ED232A; padding: 0.55rem 1rem; font-size: 0.65rem;"
      >
        Get a Quote
      </a>
    </div>
  </div>

  <!-- Related packages: other Northeast USA tours that pair naturally with New York -->
  <section id="related" class="py-16 lg:py-20" style="background-color: #F9F7F2;">
    <div class="container">
      <div class="main-content">
        <div class="flex items-center justify-between mb-10 gap-4">
          <div>
            <span class="section-label mb-3 inline-flex">Related Tours</span>
            <h2 class="text-3xl font-black" style="color: #1A2744;">Other Tours in New York</h2>
          </div>
          <a href="/packages" class="hidden sm:flex items-center gap-2 font-bold text-sm uppercase tracking-widest text-gray-400 hover:text-navy transition-all">
            View All Packages
            <ArrowRight size={16} stroke-width={2.5} />
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPackages.map((rp) => (
            <a href="/packages" class="rounded-2xl overflow-hidden card-hover block bg-white border border-gray-100" style="box-shadow: 0 4px 24px rgba(26,39,68,0.08);">
              <div class="h-32 relative">
                <div class="absolute inset-0" style={`background: ${rp.gradient};`} />
                <div class="absolute inset-0 diagonal-lines" />
                <div class="absolute bottom-0 left-0 right-0 p-5">
                  <span class="badge badge-yellow mb-2 text-xs">{rp.days} Days</span>
                  <h3 class="text-base font-black text-white">{rp.name}</h3>
                </div>
              </div>
              <div class="p-5 flex items-center justify-between text-xs">
