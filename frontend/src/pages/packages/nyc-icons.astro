  <style>
    .jump-link:hover {
      background-color: rgba(26, 39, 68, 0.06);
    }
    .jump-link.is-active {
      background-color: #FDEA01;
    }
    .on-page-nav {
      opacity: 0;
      visibility: hidden;
      transform: translateX(24px);
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
    }
    .on-page-nav.is-visible {
      opacity: 1;
      visibility: visible;
      transform: translateX(0);
    }
    /* Keep the "Book Instantly" / "What Happens Next" panel in view alongside
       the booking form as the user scrolls through it. */
    @media (min-width: 1024px) {
      .request-sidebar {
        position: sticky;
        top: 96px;
        align-self: start;
      }
    }
    /* Reserve just enough right clearance to clear the fixed nav panel (200px wide,
       2rem from the viewport edge) — shrinks as the viewport widens past the
       container's 1280px max-width, and drops to zero once the container's own
       right edge already clears the panel (~1712px+). */
    @media (min-width: 1280px) {
      .main-content {
        padding-right: max(0px, calc(856px - 50vw));
      }
    }
  </style>

  <script>
    // With the site's <ClientRouter /> (View Transitions) enabled, script tags only
    // execute once per browser session — navigating away and back to this page would
    // otherwise leave the observers below wired to elements that no longer exist.
    // Re-run this setup on every navigation (including the first) via astro:page-load.
    let jumpObserver: IntersectionObserver | null = null;
    let overviewObserver: IntersectionObserver | null = null;
    let pageContentObserver: IntersectionObserver | null = null;

    function initOnPageNav() {
      jumpObserver?.disconnect();
      overviewObserver?.disconnect();
      pageContentObserver?.disconnect();

      const jumpLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".jump-link"));
      const targets = jumpLinks
        .map((link) => {
          const id = link.dataset.target;
          const el = id ? document.getElementById(id) : null;
          return el ? { link, el } : null;
        })
        .filter((t): t is { link: HTMLAnchorElement; el: HTMLElement } => t !== null);

      function setActive(id: string) {
        jumpLinks.forEach((link) => {
          link.classList.toggle("is-active", link.dataset.target === id);
        });
      }

      if (targets.length) {
        jumpObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) setActive(entry.target.id);
            });
          },
          { rootMargin: "-120px 0px -55% 0px", threshold: 0 }
        );
        targets.forEach(({ el }) => jumpObserver!.observe(el));
      }

      // Slide the fixed "On This Page" panel in once the Tour Overview section is
      // actually on screen (not just a sliver at the bottom edge), and keep it
      // visible for the rest of the content section until it scrolls out of view.
      const pageNav = document.querySelector<HTMLElement>(".on-page-nav");
      const overviewSection = document.getElementById("overview");
      const pageContent = document.getElementById("page-content");
      if (pageNav && overviewSection && pageContent) {
        let reachedOverview = false;
        let withinPageContent = false;
        const updateNavVisibility = () => {
          pageNav.classList.toggle("is-visible", reachedOverview && withinPageContent);
        };

        overviewObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                reachedOverview = true;
              } else if (entry.boundingClientRect.top > 0) {
                // Overview hasn't been scrolled to yet (still below the viewport) — keep hidden.
                reachedOverview = false;
              }
              // Otherwise Overview has been scrolled past (above the viewport) — stays revealed.
              updateNavVisibility();
            });
          },
          { rootMargin: "0px 0px -50% 0px", threshold: 0 }
        );
        overviewObserver.observe(overviewSection);

        pageContentObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              withinPageContent = entry.isIntersecting;
              updateNavVisibility();
            });
          },
          { rootMargin: "-50% 0px 0px 0px", threshold: 0 }
        );
        pageContentObserver.observe(pageContent);
      }
    }

    document.addEventListener("astro:page-load", initOnPageNav);
  </script>

</BaseLayout>
