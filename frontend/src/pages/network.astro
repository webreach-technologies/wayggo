---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import CoverageMapTeaser from "../components/sections/CoverageMapTeaser.astro";
import HubGrid from "../components/sections/HubGrid.astro";
import IconCardGrid from "../components/sections/IconCardGrid.astro";
import FeatureStrip from "../components/sections/FeatureStrip.astro";
import PartnerCTA from "../components/sections/PartnerCTA.astro";
import ClosingStatement from "../components/sections/ClosingStatement.astro";
import { Clipboard, ShieldCheck, Search, Users } from "@lucide/astro";

const usHubs = [
  { city: "New York City", state: "NY", note: "East Coast hub serving JFK, LGA, and EWR airport connections." },
  { city: "Los Angeles", state: "CA", note: "West Coast hub serving LAX and the greater Los Angeles area." },
  { city: "Chicago", state: "IL", note: "Midwest hub serving O'Hare and Midway airport connections." },
  { city: "Las Vegas", state: "NV", note: "Convention and group travel hub serving the Las Vegas market." },
  { city: "Miami", state: "FL", note: "South Florida hub serving MIA and surrounding group travel routes." },
  { city: "Orlando", state: "FL", note: "Major destination for theme park, leisure, and convention groups." },
  { city: "San Francisco", state: "CA", note: "Bay Area hub serving SFO, Oakland, and surrounding destinations." },
  { city: "Washington D.C.", state: "DC", note: "Capital-region hub serving Reagan and Dulles airport connections." },
  { city: "Boston", state: "MA", note: "New England hub serving Logan and surrounding group travel routes." },
  { city: "Seattle", state: "WA", note: "Pacific Northwest hub serving SEA-TAC and the surrounding region." },
  { city: "Dallas", state: "TX", note: "Texas hub serving DFW, Love Field, and surrounding destinations." },
  { city: "Houston", state: "TX", note: "Gulf Coast hub serving IAH and the greater Houston area." },
  { city: "Phoenix", state: "AZ", note: "Southwest hub serving PHX and surrounding destinations." },
  { city: "Denver", state: "CO", note: "Mountain-region hub serving DEN and the surrounding area." },
  { city: "Atlanta", state: "GA", note: "Southeast hub serving Hartsfield-Jackson and the greater Atlanta market." },
];

const canadaHubs = [
  { city: "Toronto", prov: "ON", note: "Eastern Canada hub serving Pearson and surrounding destinations." },
  { city: "Vancouver", prov: "BC", note: "Pacific Canada hub serving YVR and the surrounding region." },
  { city: "Montreal", prov: "QC", note: "Quebec hub serving Trudeau and surrounding destinations." },
  { city: "Calgary", prov: "AB", note: "Alberta hub serving YYC and the surrounding region." },
  { city: "Ottawa", prov: "ON", note: "Canadian capital-region hub serving YOW and surrounding destinations." },
  { city: "Quebec City", prov: "QC", note: "Historic Quebec destination serving YQB and surrounding group travel routes." },
];

const vetDetails = [
  {
    icon: Clipboard,
    title: "Licensing & Compliance",
    desc: "Operators are required to maintain the applicable regulatory credentials, including FMCSA registration in the United States and Transport Canada certification in Canada, with verification conducted annually.",
  },
  {
    icon: ShieldCheck,
    title: "Insurance Verification",
    desc: "WAYGGO requires stated minimum liability coverage for its motorcoach, van, and shuttle operators, with insurance verified directly with the insurer.",
  },
  {
    icon: Search,
    title: "Vehicle Inspection Records",
    desc: "The process includes review of DOT inspection certificates and maintenance records, together with WAYGGO physical inspections on the stated schedule.",
  },
  {
    icon: Users,
    title: "Driver Background Checks",
    desc: "Driver requirements include background screening, CDL verification where applicable, driving-record review, and annual drug testing.",
  },
];
---

<BaseLayout
  title="Our Network — 500+ Operators Across USA & Canada | WAYGGO Charters"
  description="WAYGGO Charters' ground transportation network spans 21 hub cities across the USA and Canada with 500+ vetted bus, motorcoach, and van operators. View our interactive coverage map."
  breadcrumbs={[{ name: "Network", path: "/network" }]}
>

  <!-- Hero -->
  <PageHero
    badge="Our Network"
    heading={'500+ Operators.<br /><span style="color: #FDEA01;">One Coordinated Transportation Network.</span>'}
    subheading={"A multi-city group itinerary can involve multiple transportation providers, different local requirements, and a long list of details to coordinate. WAYGGO brings those transportation relationships together through a vetted operator network across the United States and Canada.<br /><br />From Vancouver to Miami, Boston to Los Angeles, our network is designed to help international tour operators, travel agencies, and other group travel professionals arrange transportation across multiple destinations through one coordinated relationship."}
  />

  <TrustBar
    intro={false}
    stats={[
      { value: "500+", label: "Vetted Operators" },
      { value: "21", label: "Major Hub Cities" },
      { value: "12", label: "Point Vetting Process" },
      { value: "98.7%", label: "On-Time Rate" },
    ]}
  />

  <CoverageMapTeaser
    badge="Our Hub City Network"
    heading={"Transportation Capability Across\nMajor North American Destinations"}
    subheading={"WAYGGO's network connects travel professionals with local transportation operators in major destinations across the United States and Canada.\nThe value of the network is not simply the number of cities. It is the ability to coordinate transportation where the itinerary takes the group—while maintaining a consistent relationship and approach throughout the journey."}
    ctaHref="/contact"
    ctaLabel="Check Availability"
  />

  <HubGrid
    badge="United States"
    heading="US Hub Cities"
    hubs={usHubs.map((h) => ({ city: h.city, code: h.state, note: h.note }))}
  />

  <HubGrid
    badge="Canada"
    heading="Canadian Hub Cities"
    background="cream"
    hubs={canadaHubs.map((h) => ({ city: h.city, code: h.prov, note: h.note }))}
  />

  <IconCardGrid
    badge="Quality Assurance"
    heading="How We Vet Our Operators"
    subheading={"A transportation network is only as useful as the standards behind it.\nWAYGGO states that every operator in its network passes a 12-point vetting process before receiving a first assignment, followed by ongoing re-certification. The process is designed to evaluate the areas that matter when another company is responsible for moving a client's group."}
    items={vetDetails}
    columns={2}
  />

  <FeatureStrip
    heading="More Than a Name in a Database"
    text={"For a travel professional, knowing that an operator exists in a destination is only the beginning. The more important question is whether that transportation relationship can support the itinerary with the standards and information required to coordinate the journey responsibly.\nThat is why WAYGGO's network is built around vetting, verification, and ongoing oversight rather than simply collecting transportation providers."}
  />

  <PartnerCTA
    badge="Tell Us Where the Group Is Going"
    heading="Your City. Our Operator."
    headingHighlight="Less Guesswork."
    subheading={"Multi-city transportation becomes more manageable when the local relationships are already part of a coordinated network.\nShare the cities, dates, group requirements, and itinerary details with WAYGGO. Our team can work through the transportation requirements with you and identify the appropriate local operator relationships for the journey.\nYou coordinate the trip. WAYGGO coordinates the transportation network behind it."}
    primaryCta={{ label: "Request a Quote", href: "/contact" }}
    secondaryCta={{ label: "Browse Tour Bus", href: "/tour-bus" }}
  />

  <ClosingStatement
    heading="WAYGGO Network"
    paragraph={"WAYGGO's network is built to solve a practical problem in group travel: transportation often becomes fragmented as an itinerary crosses cities, regions, and borders. By connecting travel professionals with transportation operators across the United States and Canada, WAYGGO provides a more coordinated way to manage that complexity.\nFor international tour operators and travel agencies, the network is not simply a list of vehicles or cities. It is the transportation relationship behind the itinerary.\nOne relationship. A coordinated transportation network."}
  />

  <script>
    import { initCounters } from '../utils/counterAnimation.js';

    // With the site's <ClientRouter /> (View Transitions) enabled, script tags only
    // execute once per browser session — revisiting this page later in the same
    // session would otherwise leave the counters with no IntersectionObserver
    // wired up. Re-run setup on every navigation (including the first) via
    // astro:page-load.
    document.addEventListener('astro:page-load', () => initCounters());
  </script>

</BaseLayout>
