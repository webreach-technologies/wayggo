---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import CoverageMapTeaser from "../components/sections/CoverageMapTeaser.astro";
import HubGrid from "../components/sections/HubGrid.astro";
import IconCardGrid from "../components/sections/IconCardGrid.astro";
import PartnerCTA from "../components/sections/PartnerCTA.astro";
import { Clipboard, ShieldCheck, Search, Users } from "@lucide/astro";

const usHubs = [
  { city: "New York City", state: "NY", note: "East Coast hub — JFK, LGA, EWR airports" },
  { city: "Los Angeles", state: "CA", note: "West Coast hub — LAX airport" },
  { city: "Chicago", state: "IL", note: "Midwest hub — O'Hare + Midway" },
  { city: "Las Vegas", state: "NV", note: "Convention capital — McCarran airport" },
  { city: "Miami", state: "FL", note: "South Florida hub — MIA airport" },
  { city: "Orlando", state: "FL", note: "Theme park & convention hub" },
  { city: "San Francisco", state: "CA", note: "Bay Area — SFO + Oakland airports" },
  { city: "Washington D.C.", state: "DC", note: "Capital hub — Reagan + Dulles airports" },
  { city: "Boston", state: "MA", note: "New England hub — Logan airport" },
  { city: "Seattle", state: "WA", note: "Pacific NW hub — SEA-TAC airport" },
  { city: "Dallas", state: "TX", note: "Texas hub — DFW + Love Field" },
  { city: "Houston", state: "TX", note: "Gulf Coast hub — IAH airport" },
  { city: "Phoenix", state: "AZ", note: "Southwest hub — PHX airport" },
  { city: "Denver", state: "CO", note: "Mountain hub — DEN airport" },
  { city: "Atlanta", state: "GA", note: "Southeast hub — Hartsfield-Jackson (world's busiest)" },
];

const canadaHubs = [
  { city: "Toronto", prov: "ON", note: "Eastern Canada hub — Pearson airport" },
  { city: "Vancouver", prov: "BC", note: "Pacific Canada hub — YVR airport" },
  { city: "Montreal", prov: "QC", note: "Quebec hub — Trudeau airport" },
  { city: "Calgary", prov: "AB", note: "Alberta hub — YYC airport" },
  { city: "Ottawa", prov: "ON", note: "Capital of Canada — YOW airport" },
  { city: "Quebec City", prov: "QC", note: "Historic city — YQB airport" },
];

const vetDetails = [
  {
    icon: Clipboard,
    title: "Licensing & Compliance",
    desc: "Every operator holds valid Federal Motor Carrier Safety Administration (FMCSA) registration in the US and Transport Canada certification, verified annually.",
  },
  {
    icon: ShieldCheck,
    title: "Insurance Verification",
    desc: "Minimum $5M liability coverage for all motorcoach operators, $1M for vans and shuttles, verified with direct insurer confirmation.",
  },
  {
    icon: Search,
    title: "Vehicle Inspection Records",
    desc: "We require annual DOT inspection certificates, maintenance logs, and a WAYGGO Charters physical inspection every 2 years.",
  },
  {
    icon: Users,
    title: "Driver Background Checks",
    desc: "All drivers pass TSA-equivalent background screening, CDL verification, driving record review, and annual drug testing.",
  },
];
---

<BaseLayout
  title="Our Network — 500+ Operators Across USA & Canada | WAYGGO Charters"
  description="WAYGGO Charters' ground transportation network spans 21 hub cities across the USA and Canada with 500+ vetted bus, motorcoach, and van operators. View our interactive coverage map."
  breadcrumbs={[{ name: "Network", path: "/network" }]}
>

  <!-- Hero -->
  <PageHero
    badge="Our Coverage"
    heading={'500+ Operators.<br /><span style="color: #FDEA01;">Every Corner of North America.</span>'}
    subheading="From Vancouver to Miami, from Boston to Los Angeles — WAYGGO Charters' vetted operator network ensures your group is covered in every city on your itinerary. 15 US hubs. 6 Canadian hubs. One contact."
  />

  <TrustBar
    intro={false}
    stats={[
      { value: "500+", label: "Vetted Operators" },
      { value: "21", label: "Major Hub Cities" },
      { value: "12", label: "Point Vetting Process" },
      { value: "98.7%", label: "On-Time Rate" },
    ]}
  />

  <CoverageMapTeaser
    badge="Interactive Map"
    heading={"Our Hub City\nNetwork"}
    ctaHref="/contact"
    ctaLabel="Check Availability"
  />

  <HubGrid
    badge="United States"
    heading="US Hub Cities"
    hubs={usHubs.map((h) => ({ city: h.city, code: h.state, note: h.note }))}
  />

  <HubGrid
    badge="Canada"
    heading="Canadian Hub Cities"
    background="cream"
    hubs={canadaHubs.map((h) => ({ city: h.city, code: h.prov, note: h.note }))}
  />

  <IconCardGrid
    badge="Quality Assurance"
    heading="How We Vet Our Operators"
    subheading="Every operator in our network passes a rigorous 12-point vetting process before their first assignment — and undergoes annual re-certification."
    items={vetDetails}
    columns={2}
  />

  <PartnerCTA
    badge="Check Coverage"
    heading="Your City. Our Operator."
    headingHighlight="Zero Guesswork."
    subheading="Tell us your tour cities and we'll confirm operator availability within 24 hours."
    primaryCta={{ label: "Request a Quote", href: "/contact" }}
    secondaryCta={{ label: "Browse Tour Bus", href: "/tour-bus" }}
  />

  <script>
    import { initCounters } from '../utils/counterAnimation.js';

    // With the site's <ClientRouter /> (View Transitions) enabled, script tags only
    // execute once per browser session — revisiting this page later in the same
    // session would otherwise leave the counters with no IntersectionObserver
    // wired up. Re-run setup on every navigation (including the first) via
    // astro:page-load.
    document.addEventListener('astro:page-load', () => initCounters());
  </script>

</BaseLayout>
