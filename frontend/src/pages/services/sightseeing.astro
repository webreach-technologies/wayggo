---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import FeatureStrip from "../../components/sections/FeatureStrip.astro";
import ListCardGrid from "../../components/sections/ListCardGrid.astro";
import ItinerarySection from "../../components/sections/ItinerarySection.astro";
import FleetOverview from "../../components/sections/FleetOverview.astro";
import PartnerCTA from "../../components/sections/PartnerCTA.astro";
import heroImg from "../../assets/tourtype/Sightseeing & City Tours.png";
import { Bus, User, Mic, MapPin } from "@lucide/astro";

const routes = [
  { city: "New York City", highlights: ["Times Square", "Statue of Liberty", "Central Park", "9/11 Memorial", "Empire State Building", "Brooklyn Bridge"], vehicle: "Minibus or Motorcoach", days: "3–7 days" },
  { city: "Los Angeles", highlights: ["Hollywood Walk of Fame", "Getty Center", "Santa Monica Pier", "Beverly Hills", "Universal Studios"], vehicle: "Minibus", days: "3–5 days" },
  { city: "Chicago", highlights: ["Millennium Park", "Navy Pier", "The 606 Trail", "Art Institute", "Deep-Dish Pizza Tour"], vehicle: "Minibus or Full-Size Bus", days: "2–4 days" },
  { city: "San Francisco", highlights: ["Golden Gate Bridge", "Alcatraz Island", "Fisherman's Wharf", "Chinatown", "Muir Woods"], vehicle: "Minibus", days: "3–5 days" },
  { city: "Miami", highlights: ["Art Deco District", "Little Havana", "Wynwood Walls", "South Beach", "Everglades Day Trip"], vehicle: "Minibus or Luxury Van", days: "2–4 days" },
  { city: "Las Vegas", highlights: ["The Strip", "Fremont Street", "Grand Canyon Day Trip", "Hoover Dam", "Red Rock Canyon"], vehicle: "Minibus", days: "3–5 days" },
];

const itinerary = [
  { day: "Day 1", title: "Midtown Marvels", stops: ["Times Square", "Empire State Building", "Rockefeller Center", "St. Patrick's Cathedral", "Central Park"], vehicle: "Minibus (full day)" },
  { day: "Day 2", title: "Downtown & History", stops: ["9/11 Memorial & Museum", "Wall Street", "Brooklyn Bridge Walk", "DUMBO Brooklyn", "Brooklyn Bridge Park"], vehicle: "Minibus (full day)" },
  { day: "Day 3", title: "Icons & Boroughs", stops: ["Statue of Liberty Ferry", "Ellis Island", "High Line Park", "Chelsea Market", "Greenwich Village"], vehicle: "Minibus (half day) + ferry" },
];

const features = [
  { icon: Bus, title: "Modern Fleet", desc: "Clean, maintained, fully insured vehicles" },
  { icon: User, title: "Pro Drivers", desc: "Licensed, vetted, punctual professionals" },
  { icon: Mic, title: "Guide Coordination", desc: "We work with your tour guide or provide one" },
  { icon: MapPin, title: "Real-Time Tracking", desc: "Operations monitor every trip live" },
];

const pageURL = new URL(Astro.url.pathname, Astro.site ?? "https://wayggo.com").href;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Sightseeing & City Tour Group Transportation",
  description: "Motorcoach and minibus group sightseeing tours in NYC, LA, Chicago, San Francisco, Miami, and Las Vegas.",
  url: pageURL,
  provider: { "@type": "Organization", name: "WAYGGO Charters", url: new URL("/", Astro.site ?? "https://wayggo.com").href },
  areaServed: ["United States", "Canada"],
  serviceType: "Sightseeing Group Ground Transportation",
};
---

<BaseLayout
  title="Sightseeing & City Tours — WAYGGO Charters Group Transportation"
  description="Motorcoach and minibus group sightseeing tours in NYC, LA, Chicago, San Francisco, Miami, and Las Vegas. WAYGGO Charters provides expert-guided ground transportation for international tour groups."
  breadcrumbs={[{ name: "Services", path: "/services" }, { name: "Sightseeing & City Tours", path: "/services/sightseeing" }]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <PageHero
    badge="Tour Category"
    heading={'Sightseeing &amp;<br /><span style="color: #FDEA01;">City Tours</span>'}
    subheading="From the Manhattan skyline to the Pacific coast, WAYGGO Charters' sightseeing fleet connects international groups to North America's most iconic landmarks with professional drivers and optional expert guides."
    image={heroImg}
    imageAlt="Sightseeing and city tour group transportation — WAYGGO Charters"
    cta={{ label: "Request Sightseeing Quote", href: "/contact" }}
  />

  <FeatureStrip heading="What Every Tour Includes" features={features} />

  <ListCardGrid
    badge="Top Destinations"
    heading="Popular City Routes"
    cards={routes.map((r) => ({
      title: r.city,
      points: r.highlights,
      meta: { label: "Vehicle", value: r.vehicle },
      tag: r.days,
    }))}
  />

  <ItinerarySection
    heading="3-Day New York City Group Tour"
    subheading="Recommended for 15–28 passengers · Minibus"
    days={itinerary}
    cta={{ label: "Request This Itinerary", href: "/contact" }}
  />

  <FleetOverview badge="Right-Size Your Group" heading={"The Right Vehicle\nfor Every Group Size"} />

  <PartnerCTA
    badge="Plan Your Tour"
    heading="Plan Your"
    headingHighlight="Sightseeing Tour Today"
    subheading="Tell us your cities, group size, and dates. We'll match you with the perfect vehicle and operator within 24 hours."
    primaryCta={{ label: "Request a Quote", href: "/contact" }}
    secondaryCta={{ label: "Browse Tour Bus", href: "/tour-bus" }}
  />
</BaseLayout>
