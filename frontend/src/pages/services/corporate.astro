---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import IconCardGrid from "../../components/sections/IconCardGrid.astro";
import TableSection from "../../components/sections/TableSection.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import PartnerCTA from "../../components/sections/PartnerCTA.astro";
import heroImg from "../../assets/tourtype/Corporate & Convention Travel.png";
import { Send, RefreshCw, Award, Clipboard, Moon, FileText } from "@lucide/astro";

const conventions = [
  { name: "CES — Consumer Electronics Show", city: "Las Vegas, NV", months: "January", size: "Up to 120,000 attendees", vehicle: "Motorcoach fleet" },
  { name: "SXSW — South by Southwest", city: "Austin, TX", months: "March", size: "Up to 280,000 attendees", vehicle: "Shuttle loops + buses" },
  { name: "NAB Show", city: "Las Vegas, NV", months: "April", size: "Up to 90,000 attendees", vehicle: "Motorcoach + shuttle" },
  { name: "Dreamforce (Salesforce)", city: "San Francisco, CA", months: "September", size: "Up to 170,000 attendees", vehicle: "Shuttle loops" },
  { name: "IMEX America", city: "Las Vegas, NV", months: "October", size: "Up to 14,000 attendees", vehicle: "VIP van + Motorcoach" },
  { name: "Chicago Auto Show", city: "Chicago, IL", months: "February", size: "Up to 800,000 attendees", vehicle: "Convention shuttle" },
];

const services = [
  { icon: Send, title: "Airport Delegation Pickup", desc: "Coordinated arrivals across multiple flights, terminals, and airlines — zero delegates left behind." },
  { icon: RefreshCw, title: "Shuttle Loop Management", desc: "Continuous hotel-to-venue loops timed to session breaks, with real-time adjustments." },
  { icon: Award, title: "VIP Executive Transfer", desc: "Luxury van service for C-suite delegates, speakers, and VIP guests." },
  { icon: Clipboard, title: "On-Site Coordinator", desc: "A WAYGGO Charters coordinator on the ground for groups of 50+ delegates." },
  { icon: Moon, title: "Evening Event Transport", desc: "After-hours gala and dinner transport with precise scheduling." },
  { icon: FileText, title: "Consolidated Invoicing", desc: "One invoice per delegation — simplified billing for corporate travel managers." },
];

const pageURL = new URL(Astro.url.pathname, Astro.site ?? "https://wayggo.com").href;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Corporate & Convention Group Transportation",
  description: "Professional ground transportation for corporate delegations and convention groups in Las Vegas, NYC, Chicago, and San Francisco.",
  url: pageURL,
  provider: { "@type": "Organization", name: "WAYGGO Charters", url: new URL("/", Astro.site ?? "https://wayggo.com").href },
  areaServed: ["United States", "Canada"],
  serviceType: "Corporate Group Ground Transportation",
};
---

<BaseLayout
  title="Corporate & Convention Travel — WAYGGO Charters Group Transportation"
  description="Professional ground transportation for corporate delegations and convention groups in Las Vegas, NYC, Chicago, and San Francisco. WAYGGO Charters handles CES, SXSW, NAB, and more."
  breadcrumbs={[{ name: "Services", path: "/services" }, { name: "Corporate & Convention Travel", path: "/services/corporate" }]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <PageHero
    badge="For Corporate Operators"
    heading={'Corporate &amp;<br /><span style="color: #FDEA01;">Convention Travel</span>'}
    subheading="When your delegation lands in North America, every minute counts. WAYGGO Charters delivers precision ground logistics for corporate groups, industry conventions, and executive travel programs — managing complexity so your clients experience nothing but seamless movement."
    image={heroImg}
    imageAlt="Corporate and convention group transportation — WAYGGO Charters"
    cta={{ label: "Request Corporate Quote", href: "/contact" }}
  />

  <IconCardGrid
    badge="Our Services"
    heading="Complete Corporate Transport Solutions"
    items={services}
  />

  <TableSection
    badge="Event Experience"
    heading="Major Conventions We Serve"
    background="cream"
    columns={[
      { key: "name", label: "Convention", variant: "strong" },
      { key: "city", label: "City" },
      { key: "months", label: "Month", variant: "badge" },
      { key: "vehicle", label: "Recommended Vehicle", variant: "muted" },
    ]}
    rows={conventions}
  />

  <HowItWorks />

  <PartnerCTA
    badge="Corporate Travel"
    heading="Planning a Corporate"
    headingHighlight="Tour or Convention?"
    subheading="Submit your delegation size, convention dates, and hotel locations. We'll build a precision transport plan within 24 hours."
    primaryCta={{ label: "Request a Corporate Quote", href: "/contact" }}
    secondaryCta={{ label: "Register as Corporate Partner", href: "/portal" }}
  />
</BaseLayout>
