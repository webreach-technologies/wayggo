---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import FeatureStrip from "../../components/sections/FeatureStrip.astro";
import IconCardGrid from "../../components/sections/IconCardGrid.astro";
import ChipCloud from "../../components/sections/ChipCloud.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import PartnerCTA from "../../components/sections/PartnerCTA.astro";
import heroImg from "../../assets/tourtype/Wedding & Special Events.png";
import { Star, User, Clock, Heart, RefreshCw, Bus, Send, Sunrise, LayoutGrid, MapPin } from "@lucide/astro";

const highlights = [
  { icon: Star, title: "Elegantly Presented", desc: "Immaculate vehicles with optional floral or ribbon decoration" },
  { icon: User, title: "Formally Dressed Drivers", desc: "Professional attire to match your event's formality" },
  { icon: Clock, title: "Zero-Latency Timing", desc: "Synchronized with your ceremony and reception schedule" },
  { icon: Heart, title: "Bridal Party Priority", desc: "Dedicated bridal coach with privacy partition available" },
];

const services = [
  { icon: RefreshCw, title: "Guest Shuttle Loops", desc: "Continuous loops between hotel blocks and venue throughout the day and evening.", tag: "Minibus or Shuttle" },
  { icon: Bus, title: "Bridal Party Coach", desc: "Dedicated luxury coach for the wedding party — from getting ready to the ceremony.", tag: "Luxury Van" },
  { icon: Send, title: "Airport Reception Transfers", desc: "Coordinated arrivals for out-of-town guests across multiple flight times.", tag: "Vans & Minibuses" },
  { icon: Sunrise, title: "Farewell Transfers", desc: "Post-wedding morning transfers from hotel to airport or train station.", tag: "Vans & Buses" },
  { icon: LayoutGrid, title: "Multi-Venue Events", desc: "Cocktail hour, dinner, and after-party at different venues — we handle all legs.", tag: "Fleet Mix" },
  { icon: MapPin, title: "Destination Wedding Packages", desc: "Niagara Falls, Vegas, NYC, Miami — full transport package for destination weddings.", tag: "Custom Fleet" },
];

const cities = ["Las Vegas, NV", "Niagara Falls, NY/ON", "New York City, NY", "Miami Beach, FL", "Napa Valley, CA", "Chicago, IL", "Sedona, AZ", "Savannah, GA", "Whistler, BC", "Montreal, QC", "Victoria, BC", "Banff, AB"];

const pageURL = new URL(Astro.url.pathname, Astro.site ?? "https://wayggo.com").href;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Wedding & Special Event Group Transportation",
  description: "Luxury coach and shuttle services for destination weddings, wedding parties, and special events across North America.",
  url: pageURL,
  provider: { "@type": "Organization", name: "WAYGGO Charters", url: new URL("/", Astro.site ?? "https://wayggo.com").href },
  areaServed: ["United States", "Canada"],
  serviceType: "Wedding & Event Group Ground Transportation",
};
---

<BaseLayout
  title="Wedding & Special Event Transportation — WAYGGO Charters"
  description="Luxury coach and shuttle services for destination weddings, wedding parties, and special events across North America. Elegant, punctual, professionally managed."
  breadcrumbs={[{ name: "Services", path: "/services" }, { name: "Wedding & Special Events", path: "/services/weddings" }]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <PageHero
    badge="Weddings & Events"
    heading={'Wedding &amp;<br /><span style="color: #FDEA01;">Special Events</span>'}
    subheading="Your clients are traveling from across the world for one perfect day. WAYGGO Charters ensures every guest moves elegantly from ceremony to reception, hotel to venue, arrival to farewell — without a single logistical worry."
    image={heroImg}
    imageAlt="Wedding and special event group transportation — WAYGGO Charters"
    cta={{ label: "Request Wedding Transport", href: "/contact" }}
  />

  <FeatureStrip features={highlights} />

  <IconCardGrid
    badge="Services"
    heading="Complete Wedding Transport Services"
    items={services}
  />

  <ChipCloud heading="Top Destination Wedding Cities" items={cities} />

  <HowItWorks />

  <PartnerCTA
    badge="Weddings & Events"
    heading="Let's Make It"
    headingHighlight="Perfect"
    subheading="Share the wedding date, guest count, and venues. We'll design an elegant transport plan that blends seamlessly into your event."
    primaryCta={{ label: "Request Wedding Transport Quote", href: "/contact" }}
    secondaryCta={{ label: "Register as Travel Partner", href: "/portal" }}
  />
</BaseLayout>
