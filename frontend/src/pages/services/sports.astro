---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import FeatureStrip from "../../components/sections/FeatureStrip.astro";
import ListCardGrid from "../../components/sections/ListCardGrid.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import PartnerCTA from "../../components/sections/PartnerCTA.astro";
import heroImg from "../../assets/tourtype/Sports Teams & Fan Group Travel.png";
import { MapPin, Luggage, Calendar, Zap } from "@lucide/astro";

const features = [
  { icon: MapPin, title: "Stadium Door Drops", desc: "Precise gate-level drop-off and pick-up timing" },
  { icon: Luggage, title: "Team Equipment Capable", desc: "Large luggage hold for gear and equipment bags" },
  { icon: Calendar, title: "Multi-Game Scheduling", desc: "Multi-city sports tour packages across 5–10 days" },
  { icon: Zap, title: "Fan Group Energy", desc: "Fun, safe coaches for enthusiastic supporter groups" },
];

const tours = [
  { sport: "NFL Experience", cities: ["New York (MetLife)", "Chicago (Soldier Field)", "Dallas (AT&T Stadium)", "Los Angeles (SoFi Stadium)"], vehicle: "Motorcoach" },
  { sport: "MLB Baseball Tour", cities: ["NYC (Yankee Stadium)", "Chicago (Wrigley Field)", "Boston (Fenway Park)", "Toronto (Rogers Centre)"], vehicle: "Full-Size Bus" },
  { sport: "NBA City Hopper", cities: ["Chicago (United Center)", "Miami (Kaseya Center)", "Los Angeles (Crypto.com Arena)", "New York (MSG)"], vehicle: "Full-Size Bus" },
  { sport: "Soccer Fan Tour", cities: ["Toronto FC", "LA Galaxy", "New York Red Bulls", "Chicago Fire"], vehicle: "Minibus or Full-Size Bus" },
  { sport: "NHL Ice Tour", cities: ["Toronto (Scotiabank)", "Montreal (Bell Centre)", "Chicago (United Center)", "Boston (TD Garden)"], vehicle: "Full-Size Bus" },
  { sport: "Grand Slam Tennis", cities: ["New York (US Open)", "Cincinnati Masters", "Miami Open", "Indian Wells Masters"], vehicle: "Minibus or Van" },
];

const pageURL = new URL(Astro.url.pathname, Astro.site ?? "https://wayggo.com").href;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Sports Team & Fan Group Transportation",
  description: "Game day transportation, team charters, and fan group buses across North America.",
  url: pageURL,
  provider: { "@type": "Organization", name: "WAYGGO Charters", url: new URL("/", Astro.site ?? "https://wayggo.com").href },
  areaServed: ["United States", "Canada"],
  serviceType: "Sports Group Ground Transportation",
};
---

<BaseLayout
  title="Sports Teams & Fan Group Transportation — WAYGGO Charters"
  description="Game day transportation, team charters, and fan group buses across North America. WAYGGO Charters serves sports teams, fan clubs, and tour operators bringing international groups to major sporting events."
  breadcrumbs={[{ name: "Services", path: "/services" }, { name: "Sports Teams & Fan Group Travel", path: "/services/sports" }]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <PageHero
    badge="Sports Group Travel"
    heading={'Sports Teams &amp;<br /><span style="color: #FDEA01;">Fan Group Travel</span>'}
    subheading="From the Super Bowl to the NBA Finals, from baseball road trips to international soccer friendlies — WAYGGO Charters moves sports groups to stadiums across North America with game-day precision."
    image={heroImg}
    imageAlt="Sports team and fan group transportation — WAYGGO Charters"
    cta={{ label: "Plan Your Sports Tour", href: "/contact" }}
  />

  <FeatureStrip features={features} />

  <ListCardGrid
    badge="Sports Experiences"
    heading="Popular Sports Tour Routes"
    background="cream"
    cards={tours.map((t) => ({ title: t.sport, points: t.cities, tag: t.vehicle }))}
  />

  <HowItWorks />

  <PartnerCTA
    badge="Game Day Ready"
    heading="Book Your"
    headingHighlight="Sports Group Transport"
    subheading="Tell us which sport, which city, and how many fans. We'll get you there on time, every time."
    primaryCta={{ label: "Request a Sports Tour Quote", href: "/contact" }}
    secondaryCta={{ label: "Register as Travel Partner", href: "/portal" }}
  />
</BaseLayout>
