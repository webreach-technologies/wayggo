---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import FeatureStrip from "../../components/sections/FeatureStrip.astro";
import ListCardGrid from "../../components/sections/ListCardGrid.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import PartnerCTA from "../../components/sections/PartnerCTA.astro";
import heroImg from "../../assets/tourtype/Educational & Student Tours.png";
import { ShieldCheck, Users, Clock, Smartphone } from "@lucide/astro";

const destinations = [
  { city: "Washington D.C.", ideal: "History, Science, Government", sites: ["Smithsonian Institution", "National Air & Space Museum", "US Capitol", "Library of Congress", "National Zoo"] },
  { city: "Boston & Cambridge", ideal: "Higher Education, History", sites: ["Harvard University", "MIT Campus", "Freedom Trail", "Museum of Science", "Boston Public Library"] },
  { city: "Silicon Valley", ideal: "Tech, Innovation, Business", sites: ["Computer History Museum", "Stanford University", "NASA Ames", "Apple HQ", "Google Campus"] },
  { city: "Toronto, Canada", ideal: "Science, Arts, Education", sites: ["ROM (Royal Ontario Museum)", "University of Toronto", "Ontario Science Centre", "OCAD University", "CN Tower"] },
  { city: "Chicago", ideal: "Science, Arts, Culture", sites: ["Field Museum", "Shedd Aquarium", "Adler Planetarium", "Art Institute", "University of Chicago"] },
  { city: "New York City", ideal: "Arts, Diplomacy, History", sites: ["American Museum of Natural History", "Columbia University", "MoMA", "UN Headquarters", "Metropolitan Museum"] },
];

const features = [
  { icon: ShieldCheck, title: "Background-Checked Drivers", desc: "All drivers pass student transport compliance checks" },
  { icon: Users, title: "Chaperone Coordination", desc: "Reserved seats and communication protocols for chaperones" },
  { icon: Clock, title: "Curriculum-Timed Routing", desc: "We time stops to match your educational program" },
  { icon: Smartphone, title: "Parent Tracking Available", desc: "Real-time GPS updates for school coordinators" },
];

const pageURL = new URL(Astro.url.pathname, Astro.site ?? "https://wayggo.com").href;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Educational & Student Group Transportation",
  description: "Safe, organized ground transportation for student groups and educational tours across North America.",
  url: pageURL,
  provider: { "@type": "Organization", name: "WAYGGO Charters", url: new URL("/", Astro.site ?? "https://wayggo.com").href },
  areaServed: ["United States", "Canada"],
  serviceType: "Educational Group Ground Transportation",
};
---

<BaseLayout
  title="Educational & Student Tours — WAYGGO Charters Group Transportation"
  description="Safe, organized ground transportation for student groups and educational tours across North America. Smithsonian, Ivy League campuses, Silicon Valley, and more."
  breadcrumbs={[{ name: "Services", path: "/services" }, { name: "Educational & Student Tours", path: "/services/educational" }]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <PageHero
    badge="For Schools & Universities"
    heading={'Educational &amp;<br /><span style="color: #FDEA01;">Student Tours</span>'}
    subheading="Moving student groups requires precise timing, safe vehicles, and drivers who understand the responsibility. WAYGGO Charters' educational tour fleet is purpose-built for schools, universities, and youth travel operators worldwide."
    image={heroImg}
    imageAlt="Educational and student group tour transportation — WAYGGO Charters"
    cta={{ label: "Plan a Student Tour", href: "/contact" }}
  />

  <FeatureStrip heading="Built for Student Safety & Learning" features={features} />

  <ListCardGrid
    badge="Top Destinations"
    heading="Knowledge-Rich Destinations"
    background="cream"
    cards={destinations.map((d) => ({ title: d.city, subtitle: d.ideal, points: d.sites }))}
  />

  <HowItWorks />

  <PartnerCTA
    badge="Student Group Travel"
    heading="Ready to Plan Your"
    headingHighlight="Educational Tour?"
    subheading="Share your school's travel itinerary and we'll build the safest, most educational ground transport plan."
    primaryCta={{ label: "Request a Student Tour Quote", href: "/contact" }}
    secondaryCta={{ label: "View Suitable Vehicles", href: "/fleet" }}
  />
</BaseLayout>
