---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import FeatureStrip from "../../components/sections/FeatureStrip.astro";
import ListCardGrid from "../../components/sections/ListCardGrid.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import PartnerCTA from "../../components/sections/PartnerCTA.astro";
import heroImg from "../../assets/tourtype/Religious & Pilgrimage Groups.png";
import { Heart, Clock, Utensils, VolumeX } from "@lucide/astro";

const sites = [
  { name: "Temple Square", city: "Salt Lake City, UT", faith: "Latter-day Saints", desc: "The spiritual heart of the LDS Church, featuring the iconic Salt Lake Temple and Tabernacle." },
  { name: "Washington National Cathedral", city: "Washington D.C.", faith: "Interfaith", desc: "One of the largest cathedrals in the world — a place of beauty, prayer, and national remembrance." },
  { name: "Notre-Dame Basilica", city: "Montreal, QC", faith: "Catholic", desc: "A breathtaking Gothic Revival masterpiece and one of North America's most visited sacred sites." },
  { name: "St. Patrick's Cathedral", city: "New York City, NY", faith: "Catholic", desc: "Manhattan's iconic neo-Gothic cathedral on Fifth Avenue, a cornerstone of American Catholic heritage." },
  { name: "Niagara Falls Pilgrimage", city: "Niagara Falls, NY/ON", faith: "Multi-faith", desc: "A site of natural wonder and spiritual renewal, often incorporated into multi-faith pilgrimage routes." },
  { name: "University of Notre Dame", city: "South Bend, IN", faith: "Catholic", desc: "America's most famous Catholic university, home to the Golden Dome and Grotto of Our Lady of Lourdes." },
];

const values = [
  { icon: Heart, title: "Cultural Sensitivity", desc: "Drivers briefed on group customs and requirements" },
  { icon: Clock, title: "Prayer Time Awareness", desc: "Flexible scheduling respects daily prayer obligations" },
  { icon: Utensils, title: "Dietary Coordination", desc: "We note halal, kosher, vegetarian requirements" },
  { icon: VolumeX, title: "Quiet, Composed Service", desc: "Discreet drivers who understand the tone of sacred travel" },
];

const pageURL = new URL(Astro.url.pathname, Astro.site ?? "https://wayggo.com").href;
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Religious & Pilgrimage Group Transportation",
  description: "Respectful, punctual ground transportation for religious groups and pilgrimage tours across North America.",
  url: pageURL,
  provider: { "@type": "Organization", name: "WAYGGO Charters", url: new URL("/", Astro.site ?? "https://wayggo.com").href },
  areaServed: ["United States", "Canada"],
  serviceType: "Religious Group Ground Transportation",
};
---

<BaseLayout
  title="Religious & Pilgrimage Group Tours — WAYGGO Charters Ground Transportation"
  description="Respectful, punctual ground transportation for religious groups and pilgrimage tours across North America. Salt Lake City, Notre Dame, Washington National Cathedral, and more."
  breadcrumbs={[{ name: "Services", path: "/services" }, { name: "Religious & Pilgrimage Groups", path: "/services/religious" }]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <PageHero
    badge="Sacred Journeys"
    heading={'Religious &amp;<br /><span style="color: #FDEA01;">Pilgrimage Groups</span>'}
    subheading="We understand that religious travel carries profound significance. WAYGGO Charters provides respectful, composed, and perfectly timed ground transportation for faith groups making sacred journeys across North America."
    image={heroImg}
    imageAlt="Religious and pilgrimage group tour transportation — WAYGGO Charters"
    cta={{ label: "Plan a Pilgrimage Tour", href: "/contact" }}
  />

  <FeatureStrip features={values} />

  <ListCardGrid
    badge="Key Sites"
    heading="Sacred Sites We Serve"
    background="cream"
    cards={sites.map((s) => ({ eyebrow: s.faith, title: s.name, subtitle: s.city, desc: s.desc }))}
  />

  <HowItWorks />

  <PartnerCTA
    badge="Sacred Journeys"
    heading="Arrange Your"
    headingHighlight="Pilgrimage Transportation"
    subheading="Share your sacred sites, group size, and travel dates. We will respond within 24 hours with a respectful, tailored plan."
    primaryCta={{ label: "Request a Quote", href: "/contact" }}
    secondaryCta={{ label: "Register as Travel Partner", href: "/portal" }}
  />
</BaseLayout>
