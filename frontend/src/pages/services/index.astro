---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import ClosingStatement from "../../components/sections/ClosingStatement.astro";
import HeroQuoteBar from "../../components/sections/HeroQuoteBar.astro";
import ServiceCategoryGrid from "../../components/sections/ServiceCategoryGrid.astro";
import FleetOverview from "../../components/sections/FleetOverview.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import PartnerCTA from "../../components/sections/PartnerCTA.astro";

const categories = [
  {
    name: "Sightseeing & City Tours",
    tagline: "See More of North America. Coordinate the Journey With Confidence.",
    desc: "Move groups comfortably between landmarks, attractions, hotels, and planned stops while keeping the itinerary organized from one destination to the next.",
    href: "/services/sightseeing",
    cities: ["New York", "Los Angeles", "Chicago", "Las Vegas", "San Francisco", "Miami"],
    color: "#1A2744",
    accent: "#FDEA01",
  },
  {
    name: "Educational & Student Tours",
    tagline: "Transportation Planned Around the Learning Journey",
    desc: "Support student groups, teachers, and chaperones with organized transportation for educational visits, campus tours, museums, and multi-stop itineraries.",
    href: "/services/educational",
    cities: ["Washington D.C.", "Boston", "Cambridge", "San Francisco", "Chicago", "Toronto"],
    color: "#243460",
    accent: "#FDEA01",
  },
  {
    name: "Religious & Pilgrimage Groups",
    tagline: "Transportation for Journeys That Matter",
    desc: "Help faith-based groups travel together between places of worship, sacred destinations, accommodations, and planned activities with transportation handled thoughtfully and respectfully.",
    href: "/services/religious",
    cities: ["Salt Lake City", "Washington D.C.", "Notre Dame", "Niagara Falls", "Philadelphia", "Montreal"],
    color: "#0D1B3E",
    accent: "#FDEA01",
  },
  {
    name: "Corporate & Convention Travel",
    tagline: "Transportation That Keeps Business Moving",
    desc: "Keep meetings, venues, hotels, airports, and group movements connected with transportation planned around the business itinerary.",
    href: "/services/corporate",
    cities: ["Las Vegas", "Chicago", "New York", "San Francisco", "Dallas", "Orlando"],
    color: "#1A2744",
    accent: "#FDEA01",
  },
  {
    name: "Sports Teams & Fan Group Travel",
    tagline: "Transportation That Keeps Game Day Moving",
    desc: "Keep teams, supporters, and event groups moving between hotels, venues, stadiums, and scheduled activities.",
    href: "/services/sports",
    cities: ["New York", "Chicago", "Los Angeles", "Dallas", "Boston", "Toronto"],
    color: "#243460",
    accent: "#FDEA01",
  },
  {
    name: "Wedding & Special Events",
    tagline: "Transportation That Lets the Event Take Center Stage",
    desc: "Coordinate guest transportation between hotels, ceremony locations, receptions, and other venues with a plan built around the event schedule.",
    href: "/services/weddings",
    cities: ["New York", "Las Vegas", "Miami", "Los Angeles", "Chicago", "Niagara Falls"],
    color: "#0D1B3E",
    accent: "#FDEA01",
  },
];
---

<BaseLayout
  title="Services — WAYGGO Charters Ground Transportation"
  description="Sightseeing, Educational, Religious, Corporate, Sports, and Wedding group tours across North America. WAYGGO Charters provides dedicated ground transportation for every type of group tour."
  breadcrumbs={[{ name: "Services", path: "/services" }]}
>

  <!-- Hero -->
  <PageHero
    badge="Our Services"
    heading={'Group Transportation Built<br /><span style="color: #FDEA01;">Around Your Journey</span>'}
    subheading="Every group travels differently. A corporate delegation may need coordinated movement between hotels, meeting venues, and airports. A sightseeing group may move through several destinations over the course of a tour. A wedding, sports group, student trip, or religious journey can bring its own schedule and transportation requirements."
  />

  <ClosingStatement
    heading={false}
    align="left"
    paragraph={"WAYGGO connects each type of journey with the transportation it requires, helping groups travel together while giving the people planning the trip a simpler way to manage the ground operation. A vehicle is only one part of group transportation. The purpose of the journey shapes the way transportation needs to be planned.\nWhether the itinerary involves sightseeing across a major city, a multi-day educational program, a corporate convention, a pilgrimage, a sporting event, or a wedding, WAYGGO approaches transportation in the context of the trip itself. That means considering the group, the schedule, the destinations, the vehicle requirements, and the movement between each part of the itinerary."}
  />

  <HeroQuoteBar />

  <ServiceCategoryGrid categories={categories} />

  <ClosingStatement
    heading="Transportation That Understands the Purpose of the Trip"
    paragraph="The transportation should support the journey — not become the journey."
  />

  <HowItWorks />

  <FleetOverview />

  <PartnerCTA
    badge="Custom Recommendation"
    heading="Not Sure Which"
    headingHighlight="Category Fits?"
    subheading="Tell us your itinerary and we'll recommend the right vehicle and tour structure for your group."
    primaryCta={{ label: "Get a Custom Recommendation", href: "/contact" }}
    secondaryCta={{ label: "Register as Travel Partner", href: "/portal" }}
  />

  <ClosingStatement />
</BaseLayout>
