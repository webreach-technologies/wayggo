---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import FeatureStrip from "../components/sections/FeatureStrip.astro";
import StoryTimeline from "../components/sections/StoryTimeline.astro";
import IconCardGrid from "../components/sections/IconCardGrid.astro";
import StatsPanel from "../components/sections/StatsPanel.astro";
import TeamGrid from "../components/sections/TeamGrid.astro";
import PartnerCTA from "../components/sections/PartnerCTA.astro";
import { Lock, Globe, Handshake, TrendingUp } from "@lucide/astro";

const milestones = [
  { year: "2008", event: "Founded in Toronto, Ontario with a network of 12 operators serving Eastern Canada." },
  { year: "2011", event: "Expanded to the US East Coast — New York, Washington D.C., and Boston added to the network." },
  { year: "2014", event: "Crossed 100 vetted operators. First international tour operator partnerships signed." },
  { year: "2017", event: "US coast-to-coast coverage achieved. Los Angeles, Las Vegas, and San Francisco hubs activated." },
  { year: "2020", event: "Weathered the pandemic. Maintained operator relationships and relaunched with enhanced health protocols." },
  { year: "2022", event: "Reached 350+ operators. Partner portal launched. First 200 active tour operator accounts." },
  { year: "2024", event: "500+ operators across 21 cities. Serving tour operators from 40+ countries worldwide." },
];

const values = [
  {
    icon: Lock,
    title: "Reliability Above All",
    desc: "A group tour disrupted by a no-show vehicle is a catastrophe. We treat every booking like it's our reputation on the line — because it is.",
  },
  {
    icon: Globe,
    title: "Global Understanding",
    desc: "Our team includes professionals from 12 countries. We understand the cultural nuances, time zones, and expectations of operators worldwide.",
  },
  {
    icon: Handshake,
    title: "Partnership, Not Transaction",
    desc: "We invest in long-term relationships. Your success on the ground in North America is our success as a business.",
  },
  {
    icon: TrendingUp,
    title: "Continuous Improvement",
    desc: "Every trip generates data. We use it to improve routing, timing, and operator selection for your next booking.",
  },
];
const story = [
  "WAYGGO Charters was founded in 2008 by a team of travel industry professionals who had personally experienced the fragmentation of North American ground transportation. As tour operators themselves, they knew the pain of coordinating vehicles across state and provincial lines — dealing with different carriers, different standards, and different reliability levels.",
  "The solution was simple in concept and complex in execution: build relationships with the best local operators in every major market, vet them to an uncompromising standard, and present them to the world as a unified service. One call. One contact. One invoice.",
  "Today, WAYGGO Charters serves tour operators and travel agents from over 40 countries, managing thousands of group transport days annually across 21 hub cities in the USA and Canada.",
];

const networkStats = [
  { value: "12", label: "Vetting criteria" },
  { value: "40%", label: "Application rejection rate" },
  { value: "2yr", label: "Re-certification cycle" },
  { value: "98.7%", label: "On-time performance" },
];

const team = [
  { initials: "JM", name: "James Mercer", role: "Chief Executive Officer", note: "25 years in ground transportation" },
  { initials: "LC", name: "Laura Chen", role: "VP, Partner Operations", note: "Ex-Contiki Group, 18 years" },
  { initials: "AR", name: "Amir Rashid", role: "VP, International Sales", note: "Covering 40+ countries" },
  { initials: "MK", name: "Maria Kowalski", role: "Head of Network Quality", note: "12-point vetting architect" },
];
---

<BaseLayout
  title="About WAYGGO Charters — Our Story, Mission, and Network"
  description="Learn how WAYGGO Charters became North America's most trusted B2B ground transportation partner. Founded in 2008, serving 200+ partner agencies from 40+ countries."
  breadcrumbs={[{ name: "About", path: "/about" }]}
>

  <!-- Hero -->
  <PageHero
    badge="Our Story"
    heading={'We Solve the Problem<br /><span style="color: #FDEA01;">No One Else Would</span>'}
    subheading="An international tour operator planning a 10-day North American tour had to contact 8 different bus companies in 4 different states, negotiate 8 different contracts, manage 8 invoices, and hope they all showed up. We built WAYGGO Charters to eliminate that problem entirely."
  />

  <FeatureStrip
    heading="Our Mission"
    text="To be the definitive B2B ground transportation partner for every international tour operator and travel agent who sends groups to North America — making their planning simpler, their operations more reliable, and their clients happier."
  />

  <StoryTimeline
    badge="How We Got Here"
    heading="Built by Operators, for Operators"
    paragraphs={story}
    milestones={milestones}
  />

  <IconCardGrid
    badge="Our Values"
    heading="What We Stand For"
    items={values}
    columns={2}
    background="cream"
  />

  <StatsPanel
    badge="The Network"
    heading="How We Built 500+ Trusted Partners"
    text="Every operator in the WAYGGO Charters network passed our 12-point vetting process — FMCSA licensing verification, $5M+ insurance confirmation, vehicle inspection records, driver background checks, and direct client reference interviews. We reject approximately 40% of applicants."
    stats={networkStats}
  />

  <TeamGrid heading="The People Behind WAYGGO Charters" members={team} />

  <PartnerCTA
    badge="Work With Us"
    heading="Ready to Partner"
    headingHighlight="With Us?"
    subheading="Join 200+ active partner agencies who trust WAYGGO Charters with their clients' North American ground transportation."
    primaryCta={{ label: "Request a Quote", href: "/contact" }}
    secondaryCta={{ label: "Register as Partner", href: "/portal" }}
  />

</BaseLayout>
