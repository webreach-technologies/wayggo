---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import FeatureStrip from "../components/sections/FeatureStrip.astro";
import StoryTimeline from "../components/sections/StoryTimeline.astro";
import IconCardGrid from "../components/sections/IconCardGrid.astro";
import StatsPanel from "../components/sections/StatsPanel.astro";
import TeamGrid from "../components/sections/TeamGrid.astro";
import PartnerCTA from "../components/sections/PartnerCTA.astro";
import ClosingStatement from "../components/sections/ClosingStatement.astro";
import { Lock, Globe, Handshake, TrendingUp } from "@lucide/astro";

const milestones = [
  { year: "2008", title: "Where It Began", event: "WAYGGO was founded in Toronto, Ontario with a network of 12 operators serving Eastern Canada." },
  { year: "2011", title: "Into the U.S. East Coast", event: "The network expanded into New York, Washington, D.C., and Boston, beginning a broader North American footprint." },
  { year: "2014", title: "A Growing Network", event: "WAYGGO crossed 100 vetted operators and began its first international tour operator partnerships." },
  { year: "2017", title: "Coast-to-Coast Coverage", event: "Los Angeles, Las Vegas, and San Francisco were added as network hubs, establishing coverage from the East Coast to the West Coast." },
  { year: "2020", title: "Staying Connected", event: "During the pandemic, WAYGGO maintained its operator relationships and later relaunched with enhanced health protocols as group travel began returning." },
  { year: "2022", title: "Building the Partner Platform", event: "The network reached more than 350 operators. WAYGGO launched its partner portal and reached its first 200 active tour operator accounts." },
  { year: "2024", title: "A North American Network", event: "WAYGGO reached more than 500 operators across 21 cities while serving tour operators from more than 40 countries worldwide." },
];

const values = [
  {
    icon: Lock,
    title: "Reliability Above All",
    desc: "A group itinerary depends on transportation arriving when and where it is expected. For a travel professional, a transportation problem can affect an entire day's schedule and ultimately the experience of the people traveling. We treat each transportation operation as part of the reputation we are helping our partners protect.",
  },
  {
    icon: Globe,
    title: "Global Understanding",
    desc: "North American group travel often begins with a travel professional working from another country, another time zone, and another set of expectations. WAYGGO's team includes professionals from 12 countries, giving us an appreciation for the cultural differences, communication styles, time zones, and service expectations that can shape international group travel.",
  },
  {
    icon: Handshake,
    title: "Partnership, Not Transaction",
    desc: "A transportation booking is one event. A transportation partnership can support an entire program of travel. WAYGGO is built around long-term relationships with travel professionals who need a transportation partner they can work with repeatedly as their itineraries and client requirements evolve. Your clients' experience on the ground matters to your business. It matters to ours as well.",
  },
  {
    icon: TrendingUp,
    title: "Continuous Improvement",
    desc: "Every group journey provides an opportunity to learn. Where appropriate, WAYGGO uses experience and operational information to improve decisions around routing, timing, transportation selection, and future group movements.",
  },
];

const story = [
  "WAYGGO Charters was founded in 2008 by travel industry professionals who had experienced the challenges of coordinating North American ground transportation firsthand. They understood the difficulty of working across different transportation markets, local carriers, operating standards, schedules, and expectations.",
  "The answer was not simply to find another bus company. It was to build relationships with capable local transportation operators across major markets, establish consistent standards for those relationships, and make that network easier for travel professionals to access. That approach remains central to WAYGGO today.",
  "From its beginnings in Toronto, WAYGGO expanded into major U.S. markets and continued building a broader North American transportation network. Today, the company serves tour operators and travel agents from more than 40 countries and manages group transportation across 21 hub cities in the United States and Canada.",
  "The principle behind the network has remained consistent: one transportation relationship, supported by local transportation expertise.",
];

const networkStats = [
  { value: "12", label: "Vetting Criteria" },
  { value: "40%", label: "Reported Application Rejection Rate" },
  { value: "2 Years", label: "Re-Certification Cycle" },
  { value: "98.7%", label: "Reported On-Time Performance" },
];

const team = [
  { initials: "JM", name: "James Mercer", role: "Chief Executive Officer", note: "25 years in ground transportation." },
  { initials: "LC", name: "Laura Chen", role: "VP, Partner Operations", note: "Former Contiki Group executive with 18 years of experience." },
  { initials: "AR", name: "Amir Rashid", role: "VP, International Sales", note: "Focused on international markets covering more than 40 countries." },
  { initials: "MK", name: "Maria Kowalski", role: "Head of Network Quality", note: "Responsible for the development of the 12-point network vetting approach." },
];

const partnerPoints = [
  { title: "No Registration Fee", desc: "Become a WAYGGO partner without registration or onboarding fees." },
  { title: "Responsive Coordination", desc: "Our team works with you around the requirements of your itinerary and transportation needs." },
  { title: "Dedicated Account Management", desc: "Maintain a consistent point of contact for your transportation operations." },
  { title: "Custom Invoicing", desc: "Current partner arrangements may include options such as Net-30 terms, multi-currency billing, and consolidated invoicing, subject to applicable terms." },
];
---

<BaseLayout
  title="About WAYGGO Charters — Our Story, Mission, and Network"
  description="Learn how WAYGGO Charters became North America's most trusted B2B ground transport partner. Founded in 2008, serving 200+ partner agencies from 40+ countries."
  breadcrumbs={[{ name: "About", path: "/about" }]}
>

  <!-- Hero -->
  <PageHero
    badge="About Us"
    heading={'We Solve the Problem<br /><span style="color: #FDEA01;">No One Else Would</span>'}
    subheading={'Group transportation becomes complicated when an itinerary crosses cities, states, provinces, and local transportation markets. An international tour operator planning a multi-day North American journey can find themselves coordinating different bus companies, separate contracts, multiple invoices, and different operating standards — all while being responsible for the experience of their clients.<br /><br />WAYGGO Charters was built to make that process simpler. Instead of requiring travel professionals to manage transportation market by market, WAYGGO brings the ground transportation relationship together through a connected network of local operators, vehicle options, and operational support.<br /><br /><strong class="text-white">The idea is straightforward: make North American ground transportation easier to coordinate for the people responsible for making the entire journey work.</strong>'}
  />

  <FeatureStrip
    badge="Our Mission"
    heading="To Make North American Group Transportation Simpler to Manage"
    text={"WAYGGO's mission is to be a trusted B2B ground transportation partner for international tour operators, travel agents, and other travel professionals sending groups to North America. That means looking beyond the individual vehicle or individual trip.\nOur role is to help make the transportation side of the itinerary more organized, more manageable, and more closely aligned with the way the group is actually traveling. When transportation works well, it becomes one less thing for the travel professional to worry about — and one more part of the journey that simply works."}
  />

  <StoryTimeline
    badge="How We Got Here"
    heading="Built by Operators, for Operators"
    paragraphs={story}
    milestones={milestones}
    footnote="The milestones matter, but the larger story is the network of relationships built along the way."
  />

  <IconCardGrid
    badge="Our Values"
    heading="What We Stand For"
    items={values}
    columns={2}
    background="cream"
  />

  <StatsPanel
    badge="The Network"
    heading="How We Built a Network of"
    headingHighlight="Trusted Transportation Partners"
    text={"A transportation network is only valuable when the relationships within it are meaningful. WAYGGO has developed its network by establishing relationships with local transportation operators and applying a defined vetting process before bringing operators into the network.\nThe current 12-point vetting process includes areas such as FMCSA licensing verification, insurance confirmation, vehicle inspection records, driver background checks, and direct client reference interviews. WAYGGO currently reports rejecting approximately 40% of applicants as part of that process. The network is also subject to a two-year re-certification cycle.\nThe purpose is not simply to build a large list of transportation providers. It is to create a network that travel professionals can work through with greater confidence when arranging transportation for their clients."}
    stats={networkStats}
    note="Network figures and performance metrics are based on current WAYGGO information and may be updated as the network evolves."
  />

  <TeamGrid
    heading="The People Behind WAYGGO Charters"
    subheading="A transportation network is ultimately managed by people. WAYGGO brings together experience across ground transportation, partner operations, international sales, and network quality."
    members={team}
    footnote="Together, the team brings different perspectives to the same objective: helping travel professionals coordinate the transportation behind their North American group journeys."
  />

  <PartnerCTA
    badge="Work With Us"
    heading="Ready to Partner"
    headingHighlight="With Us?"
    subheading={"WAYGGO works with travel professionals who need a transportation relationship that can support their clients across North America.\nWhether you are arranging a single group itinerary or managing recurring programs of travel, the goal is the same: make the ground transportation side of the journey easier to coordinate."}
    primaryCta={{ label: "Request a Quote", href: "/contact" }}
    secondaryCta={{ label: "Register as a Partner", href: "/portal" }}
    trustCards={partnerPoints}
  />

  <ClosingStatement
    heading="WAYGGO Charters"
    paragraph={"WAYGGO exists to make one of the most complex parts of group travel easier to manage. By bringing travel professionals together with a network of transportation operators across the United States and Canada, WAYGGO helps coordinate the vehicles and ground transportation behind the journey.\nFor us, transportation is not simply about moving a group from one place to another. It is about helping the people responsible for the journey move their clients with greater confidence."}
  />

</BaseLayout>
