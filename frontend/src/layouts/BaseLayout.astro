---
import "../styles/global.css";
import { ClientRouter } from 'astro:transitions';
import TopBar from "../components/layout/TopBar.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { ChevronUp } from "@lucide/astro";

interface Breadcrumb {
  name: string;
  /** Path relative to the site root, e.g. "/tour-services/corporate". */
  path: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  /** Trail from (but excluding) Home to this page, e.g. [{name:"Tour Services",path:"/tour-services"},{name:"Corporate",path:"/tour-services/corporate"}]. Omit on the homepage. */
  breadcrumbs?: Breadcrumb[];
  /** rel="prev"/"next" links for paginated listings, e.g. /tour-bus/usa/2. */
  prevHref?: string;
  nextHref?: string;
}

const {
  title = "WAYGGO — North America's #1 B2B Ground Transportation Partner",
  description = "WAYGGO connects international tour operators and travel agents to 500+ vetted ground transportation operators across the USA and Canada. Motorcoaches, minibuses, vans, and shuttles for every group size.",
  ogImage = "/logo.png",
  canonical,
  noindex = false,
  breadcrumbs,
  prevHref,
  nextHref,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL("https://wayggo.com");
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteOrigin).href;

// Sitewide entity — defined once here rather than per-page. Only fields backed
// by real, already-published site data (see Footer/TopBar) are included;
// `sameAs` (social profile links) is omitted until real profile URLs exist —
// fabricating them would be worse than leaving them out.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "WAYGGO",
  url: new URL("/", siteOrigin).href,
  logo: new URL("/logo.png", siteOrigin).href,
  email: "operations@wayggo.com",
  telephone: "+1-800-555-9248",
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    email: "operations@wayggo.com",
    telephone: "+1-800-555-9248",
  },
};

// Every other URL on the site (canonical, sitemap — trailingSlash: "never" in
// astro.config.mjs) resolves without a trailing slash, so breadcrumb item
// URLs need to match — otherwise Google sees them as different URLs from the
// canonical one. (The root "/" is exempt — a bare domain always normalizes
// to a trailing slash per the URL spec, so "Home" below is unaffected.)
const withoutTrailingSlash = (path: string) => (path.length > 1 ? path.replace(/\/+$/, "") : path);

// Home + whatever trail the page supplies. Omitted entirely on pages that
// don't pass `breadcrumbs` (e.g. the homepage itself).
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", siteOrigin).href },
    ...breadcrumbs.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 2,
      name: crumb.name,
      item: new URL(withoutTrailingSlash(crumb.path), siteOrigin).href,
    })),
  ],
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="WAYGGO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
<link rel="preload" href="/fonts/nunito-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    {prevHref && <link rel="prev" href={new URL(prevHref, siteOrigin).href} />}
    {nextHref && <link rel="next" href={new URL(nextHref, siteOrigin).href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {breadcrumbSchema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    <ClientRouter />
  </head>

  <body>
    <TopBar />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scroll to top button -->
    <!-- transition:persist keeps this the same DOM node across ClientRouter navigations,
         so the listeners attached below stay valid instead of targeting a detached node. -->
    <button
      id="scroll-top-btn"
      transition:persist
      aria-label="Scroll to top"
      class="fixed bottom-8 right-8 z-50 w-12 h-12 rounded-full bg-yellow shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:bg-yellow-dark focus:outline-none focus:ring-2 focus:ring-yellow focus:ring-offset-2"
    >
      <ChevronUp size={20} class="text-navy" stroke-width={2.5} aria-hidden="true" />
    </button>

    <script>
      const btn = document.getElementById('scroll-top-btn');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          btn?.classList.remove('opacity-0', 'pointer-events-none');
          btn?.classList.add('opacity-100');
        } else {
          btn?.classList.add('opacity-0', 'pointer-events-none');
          btn?.classList.remove('opacity-100');
        }
      }, { passive: true });

      btn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
